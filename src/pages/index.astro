---
// On Netlify, / is redirected server-side via netlify.toml before this page loads.
// This JS fallback only runs in local dev or non-Netlify environments.
---

<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Cheflink</title>
  <meta name="robots" content="noindex" />
  <script>
    const lang = navigator.language || navigator.languages?.[0] || 'es';
    window.location.replace(lang.startsWith('en') ? '/en/' : '/es/');
  </script>
</head>
<body></body>
</html>
