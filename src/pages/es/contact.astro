---
// Contact form, handled by Netlify Forms (the `netlify` attribute and the
// hidden `form-name` field are what Netlify's build looks for). Submissions
// are emailed to support@cheflink.io through the form's notification in the
// Netlify dashboard. After posting, Netlify sends the visitor back here with
// `?enviado=1`, which shows the thank-you note in place of the form.
import { APP_NAME, SUPPORT_EMAIL } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const field = 'mt-2 block w-full border-0 border-b border-sand-400 bg-transparent px-0 py-2.5 text-base text-ink placeholder:text-sand-400 focus:border-ink focus:outline-none focus:ring-0';
const label = 'block font-mono text-xs font-medium uppercase tracking-[0.14em] text-sand-600';
---

<BaseLayout
  lang="es"
  title={`Contacto - ${APP_NAME}`}
  description={`Escríbenos y te respondemos por correo. Soporte y consultas sobre ${APP_NAME}.`}
  canonicalPath="/es/contact/"
>
<div class="min-h-screen bg-cream text-ink">
  <Navbar lang="es" currentPage="contact" />

  <main>
    <section class="bg-cream" data-tone="cream">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 pb-20 pt-12 sm:px-6 lg:grid-cols-12 lg:gap-6 lg:px-8 lg:pb-28 lg:pt-16">
        <div class="flex flex-col gap-5 lg:col-span-5 lg:pr-10">
          <span class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-brand-700">Contacto</span>
          <h1 class="font-display text-[2.6rem] font-normal leading-[1.03] tracking-[-0.03em] sm:text-6xl">Escríbenos, <em class="text-brand-700">te leemos</em></h1>
          <p class="max-w-[34em] text-lg leading-[1.6] text-sand-600">Dudas sobre {APP_NAME}, soporte para tu local o cualquier otra consulta. Respondemos por correo, normalmente el mismo día hábil.</p>
          <dl class="mt-4 flex flex-col border-t border-ink">
            <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-sand-300 py-4">
              <dt class="font-mono text-xs uppercase tracking-[0.14em] text-sand-600">Correo</dt>
              <dd class="m-0 font-mono text-sm"><a href={`mailto:${SUPPORT_EMAIL}`} class="text-ink underline decoration-sand-400 underline-offset-4 hover:decoration-ink">{SUPPORT_EMAIL}</a></dd>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-sand-300 py-4">
              <dt class="font-mono text-xs uppercase tracking-[0.14em] text-sand-600">¿Quieres verlo en vivo?</dt>
              <dd class="m-0 text-sm"><a href="/es/demo/" class="font-semibold text-ink underline decoration-[1.5px] underline-offset-4">Agenda una demo</a></dd>
            </div>
          </dl>
        </div>

        <div class="lg:col-span-7">
          <div id="contact-sent" class="hidden border-t border-ink pt-8" role="status">
            <p class="font-display text-[2rem] leading-[1.1] tracking-[-0.02em]">Gracias, ya lo tenemos.</p>
            <p class="mt-3 max-w-[34em] text-base leading-relaxed text-sand-600">Te respondemos a tu correo lo antes posible. Si es urgente, escríbenos directo a <a href={`mailto:${SUPPORT_EMAIL}`} class="text-brand-700 underline underline-offset-4">{SUPPORT_EMAIL}</a>.</p>
          </div>

          <form
            id="contact-form"
            name="contact-es"
            method="POST"
            action="/es/contact/?enviado=1"
            netlify
            netlify-honeypot="bot-field"
            class="flex flex-col gap-7 border-t border-ink pt-8"
          >
            <input type="hidden" name="form-name" value="contact-es" />
            <p class="hidden"><label>No llenes este campo: <input name="bot-field" /></label></p>

            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label for="name" class={label}>Nombre</label>
                <input id="name" name="name" type="text" autocomplete="name" required class={field} />
              </div>
              <div>
                <label for="venue" class={label}>Restaurante <span class="normal-case tracking-normal text-sand-400">(opcional)</span></label>
                <input id="venue" name="venue" type="text" autocomplete="organization" class={field} />
              </div>
            </div>
            <div class="grid gap-7 sm:grid-cols-2">
              <div>
                <label for="email" class={label}>Correo</label>
                <input id="email" name="email" type="email" autocomplete="email" required class={field} />
              </div>
              <div>
                <label for="phone" class={label}>Teléfono <span class="normal-case tracking-normal text-sand-400">(opcional)</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" class={field} />
              </div>
            </div>
            <div>
              <label for="message" class={label}>Mensaje</label>
              <textarea id="message" name="message" rows="6" required class={field}></textarea>
            </div>
            <div class="flex flex-col-reverse gap-4 sm:flex-row sm:items-center sm:justify-between">
              <p class="max-w-[30em] text-xs leading-5 text-sand-600">Al enviar aceptas que {APP_NAME} te contacte sobre tu consulta. Nada más.</p>
              <button type="submit" class="inline-flex h-[52px] items-center justify-center rounded-full bg-brand-700 px-8 text-base font-semibold text-white shadow-[0_3px_0_#7C2D12] transition-colors hover:bg-brand-800">Enviar</button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer lang="es" />
</div>

<script>
  if (new URLSearchParams(window.location.search).has('enviado')) {
    document.getElementById('contact-form')?.classList.add('hidden');
    document.getElementById('contact-sent')?.classList.remove('hidden');
  }
</script>
</BaseLayout>
