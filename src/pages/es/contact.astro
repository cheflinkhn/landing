---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import { CALENDLY_URL } from '../../config/calendly';
---

<BaseLayout
  lang="es"
  title="Cheflink - Agenda una Demo"
  description="Agenda una llamada por Google Meet para conocer cómo Cheflink puede ayudar a tu restaurante."
  canonicalPath="/es/contact/"
>
<div class="min-h-screen bg-cream text-ink">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[420px] overflow-hidden">
    <div class="absolute left-1/2 top-0 h-[460px] w-[1000px] -translate-x-1/2 rounded-b-[50%] bg-gradient-to-b from-brand-100 via-brand-50 to-transparent"></div>
  </div>

  <Navbar lang="es" currentPage="contact" />

  <main class="relative z-10">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">Hablemos</span>
        <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Agenda una demo</h1>
        <p class="mt-4 text-lg leading-8 text-sand-600">Elige el horario que mejor te convenga y nos reunimos por Google Meet. El enlace de la reunión se te envía automáticamente al agendar.</p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-5">
        <aside class="lg:col-span-2">
          <div class="rounded-2xl border border-sand-200 bg-white p-6 shadow-soft">
            <h2 class="text-base font-semibold text-ink">Qué esperar</h2>
            <ul class="mt-4 space-y-3 text-sm text-sand-600">
              <li class="flex gap-3"><span class="mt-1.5 inline-block h-2 w-2 flex-shrink-0 rounded-full bg-brand-500"></span>Un recorrido por Cheflink adaptado a tu restaurante</li>
              <li class="flex gap-3"><span class="mt-1.5 inline-block h-2 w-2 flex-shrink-0 rounded-full bg-brand-500"></span>Respuestas sobre precios, configuración e implementación</li>
              <li class="flex gap-3"><span class="mt-1.5 inline-block h-2 w-2 flex-shrink-0 rounded-full bg-brand-500"></span>Un enlace de Google Meet enviado automáticamente al agendar</li>
            </ul>
          </div>
        </aside>

        <section class="lg:col-span-3">
          <div class="rounded-2xl border border-sand-200 bg-white p-3 shadow-soft sm:p-4">
            <div id="calendly-embed" class="min-w-[280px] overflow-hidden rounded-xl" style="height:760px;">
              <p class="p-6 text-sm text-sand-500">Cargando el calendario… Si no aparece, <a class="font-medium text-brand-700 hover:text-brand-800" href={CALENDLY_URL} target="_blank" rel="noopener">ábrelo en una pestaña nueva</a>.</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <footer class="relative z-10 border-t border-sand-200">
    <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-sand-500 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p>© <span data-year></span> Cheflink. Todos los derechos reservados.</p>
        <div class="flex gap-4">
          <a href="/es/terms/" class="transition-colors hover:text-ink">Términos</a>
          <a href="/es/privacy/" class="transition-colors hover:text-ink">Privacidad</a>
        </div>
      </div>
    </div>
  </footer>
</div>

<link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
<script src="https://assets.calendly.com/assets/external/widget.js" async></script>
<script define:vars={{ calendlyUrl: CALENDLY_URL }}>
  (function () {
    const parent = document.getElementById('calendly-embed');
    if (!parent) return;

    // Carry a `?plan=` query param through to Calendly so the chosen plan is
    // tracked with the booking (visible in your Calendly event reporting).
    const plan = (new URLSearchParams(window.location.search).get('plan') || '').trim();

    let url = calendlyUrl + (calendlyUrl.includes('?') ? '&' : '?') + 'hide_gdpr_banner=1';
    if (plan) url += '&utm_content=' + encodeURIComponent(plan);

    function init() {
      if (!window.Calendly) { window.setTimeout(init, 50); return; }
      parent.innerHTML = '';
      window.Calendly.initInlineWidget({ url, parentElement: parent });
    }
    init();
  })();
</script>
</BaseLayout>
