---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FeatureVisual from '../../components/FeatureVisual.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cheflink',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'Sistema de pedidos por QR y gestión de mesas para restaurantes y bares. Conecta pedidos por QR, cocina y cuentas por mesa en un solo panel en tiempo real.',
  url: 'https://cheflink.io/es/',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '0',
      priceCurrency: 'USD',
      description: '1 local con 1 mesa, 1 usuario, 10 items de menú, 5 pedidos al día',
    },
    {
      '@type': 'Offer',
      name: 'Premium',
      price: '99',
      priceCurrency: 'USD',
      description: '1 local con mesas ilimitadas, usuarios ilimitados, pedidos ilimitados, KDS, facturación, dashboard de ventas',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿El cliente tiene que descargar una app?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Solo escanea el código QR de la mesa y Cheflink se abre en el navegador. Ahí se puede ver el menú, hacer pedidos y vincular todo a la cuenta de esa mesa.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Puedo usar Cheflink en varias sucursales?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí. Con el plan Diamond puedes usarlo en locales ilimitados con mesas ilimitadas.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cheflink reemplaza mi POS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Puedes utilizar Cheflink junto con tu sistema de punto de venta actual, o integrándolo con un proveedor de pagos digitales para cobrar a tus clientes directamente desde el sistema.',
      },
    },
  ],
};

const features = [
  {
    title: 'Gestión de personal',
    body: 'Suma a tu equipo con roles y permisos. Controla quién toma pedidos, edita menús o cierra cuentas.',
    icon: 'M9 10a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM4 18a5 5 0 0110 0M16 10a2.5 2.5 0 10-1-4.85M20 18a5 5 0 00-3.2-4.66',
    visual: 'staff',
  },
  {
    title: 'Gestión de inventario',
    body: 'Controla el stock en tiempo real, recibe alertas de bajo inventario y mantén tu menú al día con lo que realmente hay disponible.',
    icon: 'M12 3l8 4v10l-8 4-8-4V7zM4 7l8 4 8-4M12 11v10',
    visual: 'inventory',
  },
  {
    title: 'Programa de fidelidad',
    body: 'Premia a tus clientes frecuentes con puntos y beneficios que los hacen volver, registrados automáticamente en cada visita.',
    icon: 'M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L12 16.77l-5.2 2.73.99-5.79-4.21-4.1 5.82-.85z',
    visual: 'loyalty',
  },
  {
    title: 'Facturación',
    body: 'Genera facturas y recibos con validez fiscal, con tus impuestos y cargos por servicio ya aplicados, listos para enviar o imprimir.',
    icon: 'M14 3H7a1 1 0 00-1 1v16a1 1 0 001 1h10a1 1 0 001-1V7zM14 3v4h4M9 12h6M9 16h4',
    visual: 'invoice',
  },
  {
    title: 'Reservas de mesa',
    body: 'Permite que tus clientes reserven mesa en línea y administra tu salón con una vista clara de cada próxima reserva.',
    icon: 'M5 6h14a1 1 0 011 1v12a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1zM4 10h16M8 3v4M16 3v4',
    visual: 'reservation',
  },
  {
    title: 'Pagos digitales',
    body: 'Permite que tus clientes paguen desde su teléfono o cóbrales directamente desde la cuenta con un proveedor de pagos integrado.',
    icon: 'M3 6h18a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V7a1 1 0 011-1zM2 10h20M6 15h4',
    visual: 'payment',
  },
  {
    title: 'Reportes',
    body: 'Visualiza ventas, productos más vendidos, horas pico y rendimiento por mesa en paneles claros que guían tus decisiones.',
    icon: 'M4 20h16M7 20v-6M12 20V8M17 20v-9',
    visual: 'reports',
  },
];

// Mesa del local de demostración en vivo — cada escaneo abre su propia cuenta aislada (ver el bloque de demo en #screenshots).
const demoMenuUrl = 'https://app.cheflink.io/t/757_iu-h/';
---

<BaseLayout
  lang="es"
  title="Cheflink - Pedidos por QR para restaurantes y bares"
  description="Cheflink conecta pedidos por QR, cocina y cuentas por mesa en un solo panel en tiempo real."
  canonicalPath="/es/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="min-h-screen bg-cream">
    <Navbar lang="es" currentPage="index" />

    <main>
      <!-- HERO -->
      <section id="hero" class="relative overflow-hidden">
        <div class="mx-auto flex max-w-7xl flex-col gap-14 px-4 pb-16 pt-12 sm:px-6 lg:flex-row lg:items-center lg:gap-16 lg:px-8 lg:pb-28 lg:pt-20">
          <div class="max-w-xl lg:max-w-lg">
            <h1 class="font-display text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]">
              Tu menú puede <span class="text-brand-700">vender más</span> sin hablar.
            </h1>
            <p class="mt-6 text-lg leading-8 text-sand-600">
              Cheflink conecta pedidos por QR, cocina y cuentas por mesa en un solo panel en tiempo real — menos vueltas del personal, más consumo por mesa y clientes que ya no tienen que llamar al mesero para pedir o pagar.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a
                id="signup"
                href="https://app.cheflink.io/signup/"
                class="inline-flex items-center justify-center rounded-full bg-brand-700 px-6 py-3 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-brand-800"
              >
                Pruébalo gratis
              </a>
              <a
                href="/es/contact/"
                class="inline-flex items-center justify-center rounded-full border border-sand-300 bg-white px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-sand-50"
              >
                Agendar demo
              </a>
            </div>

            <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm text-sand-600">
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-brand-600" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10.5 8.5 14 15 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>No requiere app</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-brand-600" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10.5 8.5 14 15 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Funciona con tu flujo actual</span>
              </div>
            </div>

            <dl class="mt-10 grid max-w-md grid-cols-3 gap-6 border-t border-sand-200 pt-6">
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">+30%</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">servicio más rápido en horas pico</dd>
              </div>
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">2×</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">más pedidos cuando el local se llena</dd>
              </div>
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">24/7</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">soporte por chat y correo</dd>
              </div>
            </dl>
          </div>

          <div class="relative flex-1">
            <!-- panel estructural, sin manchas borrosas -->
            <div class="absolute -right-6 -top-6 bottom-10 left-10 -z-10 rounded-[2.2rem] bg-gradient-to-br from-brand-100 via-sand-100 to-brand-50" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-lg overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-lift">
              <img src="/assets/img/screenshots/01-kds-board.png" alt="Kitchen Display System de Cheflink" class="block w-full" loading="eager" width="2880" height="1800" />
            </div>
            <div class="absolute -bottom-6 -right-2 w-[104px] overflow-hidden rounded-[1.7rem] border-[5px] border-ink bg-ink shadow-lift ring-1 ring-white/60 sm:w-[124px] sm:right-0 lg:-right-6">
              <div class="absolute left-1/2 top-0 z-10 h-[12px] w-[42px] -translate-x-1/2 rounded-b-lg bg-ink"></div>
              <img src="/assets/img/screenshots/06-consumer-menu.png" alt="Menú del cliente en Cheflink" class="block w-full" loading="eager" width="1170" height="2532" />
            </div>
          </div>
        </div>
      </section>

      <!-- FRANJA DE CONFIANZA -->
      <section class="border-y border-sand-200 bg-white">
        <div class="mx-auto grid max-w-7xl gap-6 px-4 py-8 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
          {[
            ['Sin hardware nuevo', 'Funciona en los teléfonos y pantallas que ya tienes.'],
            ['Convive con tu POS', 'Suma pedidos por QR sin cambiar lo que ya usas.'],
            ['Listo en un día', 'Arma tu menú, imprime los códigos y empieza a recibir pedidos.'],
            ['Pensado para el servicio', 'Diseñado para cómo funciona de verdad un local lleno.'],
          ].map(([title, body]) => (
            <div class="flex flex-col gap-1">
              <span class="text-sm font-semibold text-ink">{title}</span>
              <span class="text-sm leading-6 text-sand-600">{body}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- CARACTERÍSTICAS -->
      <section id="features" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">Características</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Todo lo que necesitas en un solo lugar</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">
            Cheflink es más que pedidos por QR. Gestiona todo tu salón y tu cocina —desde reservas y pagos hasta personal, inventario y reportes— sin hacer malabares con herramientas separadas.
          </p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <div class="flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-white shadow-soft transition-shadow hover:shadow-lift">
              <div class="relative flex h-44 items-center justify-center overflow-hidden border-b border-sand-200 bg-gradient-to-br from-sand-50 to-brand-50/40 px-6">
                <FeatureVisual kind={f.visual} lang="es" />
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-[0_6px_16px_-8px_rgba(249,114,22,0.6)] ring-1 ring-inset ring-white/20">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={f.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </div>
                  <h3 class="text-base font-semibold text-ink">{f.title}</h3>
                </div>
                <p class="mt-3 text-sm leading-6 text-sand-600">{f.body}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CÓMO FUNCIONA -->
      <section id="how-it-works" class="border-y border-sand-200 bg-sand-50">
        <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
          <div class="max-w-2xl">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">Cómo funciona</span>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Del escaneo al pago en tres pasos</h2>
          </div>

          <div class="relative mt-14 grid gap-6 md:grid-cols-3">
            <!-- Conector de flujo (escritorio) -->
            <div class="absolute left-[16.6%] right-[16.6%] top-[88px] hidden border-t-2 border-dashed border-sand-300 md:block" aria-hidden="true"></div>

            <!-- PASO 1 — Escanean el QR -->
            <article class="group relative z-10 flex flex-col rounded-2xl border border-sand-200 bg-white p-5 shadow-soft transition-shadow hover:shadow-lift">
              <div class="relative mb-5 flex h-44 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-sand-50 to-brand-50 ring-1 ring-sand-100">
                <span class="absolute right-3 top-3 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 font-display text-sm font-semibold text-white shadow-soft">1</span>
                <div class="relative">
                  <img src="/assets/img/landing_qr.png" alt="Código QR de mesa de Cheflink" width="112" height="112" class="h-28 w-28 rounded-lg bg-white p-1.5 shadow-soft" loading="lazy" />
                  <span class="pointer-events-none absolute -inset-2.5" aria-hidden="true">
                    <span class="absolute left-0 top-0 h-5 w-5 rounded-tl-md border-l-2 border-t-2 border-brand-500"></span>
                    <span class="absolute right-0 top-0 h-5 w-5 rounded-tr-md border-r-2 border-t-2 border-brand-500"></span>
                    <span class="absolute bottom-0 left-0 h-5 w-5 rounded-bl-md border-b-2 border-l-2 border-brand-500"></span>
                    <span class="absolute bottom-0 right-0 h-5 w-5 rounded-br-md border-b-2 border-r-2 border-brand-500"></span>
                    <span class="absolute inset-x-0 top-1/2 h-0.5 animate-pulse bg-brand-500/70"></span>
                  </span>
                </div>
              </div>
              <h3 class="text-base font-semibold text-ink">Escanean el código de la mesa</h3>
              <p class="mt-2 text-sm leading-6 text-sand-600">Cada mesa tiene un QR único que abre tu menú en el navegador del cliente. Sin descargas, sin fricción.</p>
            </article>

            <!-- PASO 2 — Los pedidos llegan a la cocina -->
            <article class="group relative z-10 flex flex-col rounded-2xl border border-sand-200 bg-white p-5 shadow-soft transition-shadow hover:shadow-lift">
              <div class="relative mb-5 flex h-44 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-sand-50 to-brand-50 ring-1 ring-sand-100">
                <span class="absolute right-3 top-3 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 font-display text-sm font-semibold text-white shadow-soft">2</span>
                <div class="w-44 -rotate-3 rounded-lg bg-white p-3 text-left shadow-lift ring-1 ring-sand-200">
                  <div class="flex items-center justify-between border-b border-dashed border-sand-200 pb-1.5">
                    <span class="font-display text-xs font-semibold text-ink">Mesa 7</span>
                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wide text-emerald-600">
                      <span class="relative flex h-1.5 w-1.5">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
                        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      </span>
                      Nuevo
                    </span>
                  </div>
                  <ul class="mt-2 space-y-1 text-xs text-sand-600">
                    <li>2× Hamburguesa</li>
                    <li>1× Papas Trufa</li>
                    <li>1× Limonada</li>
                  </ul>
                </div>
              </div>
              <h3 class="text-base font-semibold text-ink">Los pedidos llegan a la cocina</h3>
              <p class="mt-2 text-sm leading-6 text-sand-600">Cocina y meseros ven cada pedido en tiempo real, con un resaltado visual para los nuevos tickets.</p>
            </article>

            <!-- PASO 3 — Cierras la cuenta y cobras -->
            <article class="group relative z-10 flex flex-col rounded-2xl border border-sand-200 bg-white p-5 shadow-soft transition-shadow hover:shadow-lift">
              <div class="relative mb-5 flex h-44 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-sand-50 to-brand-50 ring-1 ring-sand-100">
                <span class="absolute right-3 top-3 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 font-display text-sm font-semibold text-white shadow-soft">3</span>
                <div class="relative w-44 rotate-2 rounded-lg bg-white p-3 text-left shadow-lift ring-1 ring-sand-200">
                  <div class="flex items-center justify-between">
                    <span class="font-display text-xs font-semibold text-ink">Mesa 7</span>
                    <span class="text-[10px] text-sand-400">#1042</span>
                  </div>
                  <ul class="mt-2 space-y-1 text-xs text-sand-600">
                    <li class="flex justify-between"><span>Hamburguesa ×2</span><span>$24.00</span></li>
                    <li class="flex justify-between"><span>Papas Trufa</span><span>$9.00</span></li>
                    <li class="flex justify-between"><span>Servicio 10%</span><span>$3.30</span></li>
                  </ul>
                  <div class="mt-2 flex justify-between border-t border-sand-200 pt-1.5 text-xs font-semibold text-ink">
                    <span>Total</span><span>$36.30</span>
                  </div>
                  <span class="absolute -right-2.5 top-7 rotate-12 rounded-md border-2 border-emerald-500/80 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-emerald-600">Pagado</span>
                </div>
              </div>
              <h3 class="text-base font-semibold text-ink">Cierras la cuenta y cobras</h3>
              <p class="mt-2 text-sm leading-6 text-sand-600">Aplica descuentos, cargos por servicio y marca la cuenta como pagada. Cheflink guarda el historial de cada mesa.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- SCREENSHOTS -->
      <section id="screenshots" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">El panel</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Mira Cheflink en acción</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">Un vistazo real a lo que ven tú y tu equipo todos los días.</p>
        </div>

                <div class="mb-6 mt-10 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Vistas del dashboard">
          <button type="button" role="tab" aria-selected="true" aria-controls="tab-panel-1" data-tab="1" class="screenshot-tab rounded-full border border-brand-700 bg-brand-700 px-4 py-1.5 text-sm font-medium text-white transition-colors">Estadísticas de Ventas</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-2" data-tab="2" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Menú de Backoffice</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-3" data-tab="3" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Kitchen Display System</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-4" data-tab="4" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Inventario</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-5" data-tab="5" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Vista Salón</button>
        </div>

        <div class="relative overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-lift">
          <div class="flex items-center justify-center border-b border-sand-100 bg-sand-50 px-4 py-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-xs text-sand-500 ring-1 ring-sand-200">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.7" /><path d="M8 11V8a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
              app.cheflink.io
            </span>
          </div>
          <div id="tab-panel-1" role="tabpanel"><img src="/assets/img/screenshots/03-sales-kpis.png" alt="Estadísticas de ventas en Cheflink" class="w-full" loading="eager" width="2880" height="3280" /></div>
          <div id="tab-panel-2" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/04-backoffice-menu.png" alt="Menú de backoffice en Cheflink" class="w-full" loading="lazy" width="2880" height="1800" /></div>
          <div id="tab-panel-3" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/01-kds-board.png" alt="Kitchen Display System en Cheflink" class="w-full" loading="lazy" width="2880" height="1800" /></div>
          <div id="tab-panel-4" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/05-backoffice-inventory.png" alt="Manejo de inventario en Cheflink" class="w-full" loading="lazy" width="2880" height="1800" /></div>
          <div id="tab-panel-5" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/02-kds-floor.png" alt="Vista salón en Cheflink" class="w-full" loading="lazy" width="2880" height="1800" /></div>
        </div>
      </section>

      <!-- CONSUMER EXPERIENCE -->
      <section id="consumer-view" class="border-y border-sand-200 bg-sand-50">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
          <div class="mx-auto max-w-2xl text-center">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">La experiencia del cliente</span>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Lo que ven tus clientes</h2>
            <p class="mt-4 text-lg leading-8 text-sand-600">
              Sin descargas, sin cuentas. Escanean el QR de la mesa y en segundos están viendo tu menú, haciendo su pedido y siguiendo su estado, todo desde el navegador de su teléfono.
            </p>
          </div>

          <div
            class="mt-14 flex flex-col items-center gap-6"
            id="phone-carousel"
