---
import { APP_NAME } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Ticket from '../../components/Ticket.astro';
import PixelScene from '../../components/PixelScene.astro';
import TableTent from '../../components/TableTent.astro';
import AppFrame from '../../components/AppFrame.astro';
import PhoneFrame from '../../components/PhoneFrame.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: APP_NAME,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'Sistema operativo para restaurantes: pedidos por QR o del mesero, cocina en tiempo real, cuentas por mesa, facturación, inventario y reportes en un solo panel.',
  url: 'https://cheflink.io/es/',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '0',
      priceCurrency: 'USD',
      description: '1 local con 1 mesa, 1 usuario, 10 items de menú, 5 pedidos al día',
    },
    {
      '@type': 'Offer',
      name: 'Premium',
      price: '99',
      priceCurrency: 'USD',
      description: '1 local con mesas ilimitadas, usuarios ilimitados, pedidos ilimitados, KDS, facturación, dashboard de ventas',
    },
  ],
};

const faq = [
  ['¿El cliente tiene que descargar una app?', `No. Solo escanea el código QR de la mesa y ${APP_NAME} se abre en el navegador. Ahí se puede ver el menú, hacer pedidos y vincular todo a la cuenta de esa mesa.`],
  ['¿Los clientes siempre tienen que pedir escaneando el QR?', `No. Tus meseros pueden tomar y registrar los pedidos ellos mismos en ${APP_NAME}, como siempre. Todas las cuentas y los pedidos, vengan del QR o del mesero, siguen el mismo flujo: llegan a cocina, se suman a la cuenta de la mesa y se cobran igual.`],
  [`¿Puedo usar ${APP_NAME} en varias sucursales?`, 'Sí. Con el plan Diamond puedes usarlo en locales ilimitados con mesas ilimitadas.'],
  ['¿Cada sucursal puede tener un menú distinto?', 'Sí. Mantienes un catálogo principal con todos tus platos y cada local arma su propio menú a partir de él: elige qué ofrece, con sus precios y disponibilidad, sin volver a cargar nada.'],
  [`¿${APP_NAME} reemplaza mi POS?`, `Puedes utilizar ${APP_NAME} junto con tu sistema de punto de venta actual, o integrándolo con un proveedor de pagos digitales para cobrar a tus clientes directamente desde el sistema.`],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
};

// The features as three pillars: the three places in a restaurant that have to
// talk to each other. QR ordering is one line under Salón, not the headline.
const pillars = [
  { name: 'Salón', where: 'Donde se atiende', items: [
    ['Pedidos por QR o del mesero', 'El cliente pide desde su teléfono sin app, o tu equipo lo toma desde el suyo.'],
    ['Cuentas por mesa y pagos', 'Descuentos, cargos por servicio y pago desde el teléfono o en caja.'],
    ['Vista del salón', 'Qué mesa espera qué, y desde hace cuánto, de un vistazo.'],
    ['Reservas en línea', 'Tus clientes reservan desde tu página y el salón ya sabe quién llega.'],
    ['Pedidos a domicilio', 'Desde tu propio menú, con la ubicación del cliente y seguimiento del repartidor.'],
    ['Programa de lealtad', 'Puntos y beneficios que se registran solos en cada visita.'],
  ] },
  { name: 'Cocina', where: 'Donde se produce', items: [
    ['Pantalla de cocina (KDS)', 'Cada comanda con su estado, en tiempo real, en cualquier pantalla.'],
    ['Inventario', 'Stock en tiempo real, alertas de mínimos y un menú al día con lo que hay.'],
    ['Merma', 'Registra lo que se pierde o se tira, con motivo y costo, y sale del inventario al momento.'],
    ['Bodegas', 'Centraliza las compras en una bodega y surte a cada local con pedidos internos de inventario.'],
  ] },
  { name: 'Oficina', where: 'Donde se administra', items: [
    ['Facturación', 'Facturas y recibos con validez fiscal, con impuestos y servicio ya aplicados.'],
    ['Cierres y reportes', 'Reportes X y Z, ventas, productos más vendidos, horas pico y rendimiento por mesa.'],
    ['Personal y permisos', 'Roles para quién toma pedidos, edita el menú o cierra cuentas.'],
    ['Varias sucursales', 'Todos tus locales en una sola cuenta.'],
  ] },
];

const panelTabs = [
  { id: 'sales', label: 'Ventas' },
  { id: 'menu', label: 'Administración de menú' },
  { id: 'kitchen', label: 'Cocina (KDS)' },
  { id: 'inventory', label: 'Inventario' },
  { id: 'floor', label: 'Vista salón' },
];
const defaultTab = 'kitchen';

// Mesa del local de demostración en vivo — cada escaneo abre su propia cuenta aislada.
const demoMenuUrl = 'https://app.cheflink.io/t/757_iu-h/';

const eyebrow = 'font-mono text-xs font-medium uppercase tracking-[0.14em]';
const h2 = 'font-display text-[2.4rem] font-normal leading-[1.05] tracking-[-0.025em] sm:text-5xl lg:text-[3.5rem]';
const btnPrimary = 'inline-flex h-[54px] items-center justify-center rounded-full bg-brand-700 px-8 text-base font-semibold text-white shadow-[0_3px_0_#7C2D12] transition-colors hover:bg-brand-800';
const btnLink = 'inline-flex min-h-[44px] items-center font-semibold underline decoration-[1.5px] underline-offset-[6px]';
---

<BaseLayout
  lang="es"
  title={`${APP_NAME} - El Sistema Operativo para Restaurantes`}
  description={`${APP_NAME} es el sistema operativo para restaurantes: pedidos por QR o del mesero, cocina en tiempo real, cuentas, facturación, inventario y reportes en un solo panel.`}
  canonicalPath="/es/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="min-h-screen bg-cream text-ink">
    <Navbar lang="es" currentPage="index" />

    <main>
      <!-- HERO: copy, the kitchen board as the cook sees it, and the night's tickets on the rail -->
      <section id="hero" class="relative bg-dawn" data-tone="dawn">
        <div class="mx-auto grid max-w-7xl gap-12 px-4 pb-4 pt-10 sm:px-6 lg:grid-cols-12 lg:items-start lg:gap-6 lg:px-8 lg:pt-14">
          <div class="flex flex-col items-start lg:col-span-6">
            <span class={`${eyebrow} text-sand-600`}>El sistema operativo para restaurantes</span>
            <h1 class="mt-5 font-display text-[2.75rem] font-normal leading-[1] tracking-[-0.03em] sm:text-6xl lg:text-[4.9rem]">
              Todo tu restaurante, <em class="text-brand-700">en un solo sistema.</em>
            </h1>
            <p class="mt-6 max-w-[34em] text-lg leading-[1.6] text-sand-600">
              {APP_NAME} conecta el salón, la cocina y la oficina de tu restaurante en un solo panel en tiempo real: pedidos por QR o del mesero, reservas, cocina, cuentas, facturación, inventario y reportes, sin herramientas sueltas ni capturar nada dos veces.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3">
              <a href="/es/demo/" class={btnPrimary}>Agendar demo</a>
              <a href="#try-demo" class={`${btnLink} text-ink`}>Pruébalo tú mismo</a>
            </div>
            <div class="mt-9 flex flex-wrap gap-x-6 gap-y-2 border-t border-sand-300 pt-5 text-sm text-sand-600">
              <span>Sin app para tus clientes</span>
              <span>Convive con tu POS</span>
            </div>
          </div>

          <div class="relative lg:col-span-6">
            <div class="relative mx-auto max-w-[590px] pb-8 pl-6 pt-8 sm:pl-10 lg:ml-auto lg:mr-0 lg:pt-10">
              <div class="absolute -top-1 right-4 hidden -rotate-3 items-start gap-1.5 font-hand text-[21px] leading-none text-sand-700 lg:flex" aria-hidden="true">
                así lo ve la cocina
                <svg class="mt-2 h-[50px] w-[46px]" viewBox="0 0 46 50" fill="none"><path d="M3 4c14 1 27 9 31 38" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M25 33l9 10 7-12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <AppFrame variant="tablet" tilt={1.2}>
                <img src="/assets/img/screenshots/11-kds-board-tablet.webp" alt="Kitchen Display System de Cheflink" width="2048" height="1536" loading="eager" />
              </AppFrame>
              <div class="absolute bottom-0 left-0 w-[104px] sm:w-[128px] lg:-left-3">
                <PhoneFrame tilt={-4}>
                  <img src="/assets/img/screenshots/06-consumer-menu.webp" alt="Menú del cliente en Cheflink" width="1170" height="2532" loading="eager" />
                </PhoneFrame>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 lg:mt-4">
          <PixelScene lang="es" />
        </div>
      </section>

      <!-- CONFIANZA + CÓMO FUNCIONA: on the dark ground the tickets hang into -->
      <section id="how-it-works" class="scroll-mt-24 bg-sand-100 text-ink" data-tone="sand">
        <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 lg:px-8 lg:pb-28 lg:pt-20">
          <div class="grid gap-6 border-b border-dashed border-sand-400 pb-10 sm:grid-cols-2 lg:grid-cols-4">
            {[
              ['Sin hardware nuevo', 'Funciona en los teléfonos y pantallas que ya tienes.'],
              ['Convive con tu POS', 'Úsalo junto a tu punto de venta actual, o cobra directo desde el sistema.'],
              ['Listo en un día', 'Arma tu menú, imprime los códigos y empieza a recibir pedidos.'],
              ['Pensado para el servicio', 'Diseñado para cómo funciona de verdad un local lleno.'],
            ].map(([title, body]) => (
              <div class="flex flex-col gap-1.5">
                <span class="text-[15px] font-semibold">{title}</span>
                <span class="text-sm leading-6 text-sand-600">{body}</span>
              </div>
            ))}
          </div>

          <div class="mt-16 max-w-2xl">
            <span class={`${eyebrow} text-brand-700`}>Cómo funciona</span>
            <h2 class={`mt-4 ${h2}`}>Un flujo de servicio en <em>tres pasos</em></h2>
          </div>

          <div class="relative mt-12 grid gap-12 md:grid-cols-3 md:gap-6">
            <svg class="absolute left-0 top-[140px] hidden h-[120px] w-full md:block" viewBox="0 0 1280 120" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M120 70C260 10 330 110 520 60S800 20 940 70s180 20 260-10" stroke="#A99685" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 11"/></svg>

            <div class="relative flex flex-col gap-7">
              <div class="flex h-[300px] items-center pl-4 md:h-[330px]">
                <TableTent lang="es" table="7" qr="/assets/img/landing_qr.png" />
              </div>
              <div class="flex max-w-[350px] flex-col gap-2">
                <span class="font-display text-2xl italic text-brand-700">1. La mesa</span>
                <h3 class="text-[19px] font-semibold">El cliente pide como prefiera</h3>
                <p class="text-[15px] leading-6 text-sand-600">Escanea el QR de la mesa y pide desde su teléfono, o el mesero toma el pedido en el suyo. Las reservas llegan al mismo salón.</p>
              </div>
            </div>

            <div class="relative flex flex-col gap-7">
              <div class="flex h-[300px] items-center pl-4 md:h-[330px]">
                <Ticket title="MESA 07" meta="20:41" lines={['2× Hamburguesa', '1× Papas trufa', '1× Limonada']} note="sin cebolla" status="Nuevo" statusTone="accent" size="md" clip={false} tornTop tilt={2.5} shadow="rgba(28,23,20,0.22)" />
              </div>
              <div class="flex max-w-[350px] flex-col gap-2">
                <span class="font-display text-2xl italic text-brand-700">2. La comanda</span>
                <h3 class="text-[19px] font-semibold">La cocina lo ve al instante</h3>
                <p class="text-[15px] leading-6 text-sand-600">Cada plato aparece en la pantalla de cocina con su estado, y el inventario se descuenta solo.</p>
              </div>
            </div>

            <div class="relative flex flex-col gap-7">
              <div class="flex h-[300px] items-center pl-4 md:h-[330px]">
                <Ticket title="CUENTA" meta="#1042" rows={[{ label: 'Hamburguesa ×2', value: '$24.00' }, { label: 'Papas trufa', value: '$9.00' }, { label: 'Servicio 10%', value: '$3.30' }]} total={{ label: 'Total', value: '$36.30' }} stamp="PAGADO" stampTone="ok" size="md" clip={false} tilt={-2} shadow="rgba(28,23,20,0.22)" />
              </div>
              <div class="flex max-w-[350px] flex-col gap-2">
                <span class="font-display text-2xl italic text-brand-700">3. La cuenta</span>
                <h3 class="text-[19px] font-semibold">Cobras, facturas y cierras el día</h3>
                <p class="text-[15px] leading-6 text-sand-600">La cuenta se paga desde la mesa o en caja, sale con factura, y las ventas y los reportes quedan listos sin capturar nada.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CARACTERÍSTICAS: tres pilares, como las tres partes de la casa -->
      <section id="features" class="scroll-mt-24 bg-cream" data-tone="cream">
        <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-6 lg:px-8 lg:py-28">
          <div class="flex flex-col gap-4 lg:col-span-4 lg:pr-6">
            <span class={`${eyebrow} text-brand-700`}>Características</span>
            <h2 class={h2}>Todo lo que necesitas en <em>un solo lugar</em></h2>
            <p class="mt-2 text-[17px] leading-7 text-sand-600">
              Un restaurante son tres lugares que tienen que hablarse: el salón, la cocina y la oficina. {APP_NAME} los conecta en un solo sistema, y los pedidos por QR son solo una de las puertas de entrada.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="h-1 border-b border-t border-ink" aria-hidden="true"></div>
            <div class="grid gap-x-8 gap-y-10 pt-7 md:grid-cols-3">
              {pillars.map((p) => (
                <div class="flex flex-col">
                  <span class={`${eyebrow} text-sand-600`}>{p.where}</span>
                  <h3 class="mt-2 font-display text-[30px] font-normal leading-none tracking-[-0.02em]">{p.name}</h3>
                  <ul class="mt-5 flex flex-col">
                    {p.items.map(([title, body]) => (
                      <li class="border-t border-sand-200 py-4">
                        <span class="block text-[15px] font-semibold">{title}</span>
                        <span class="mt-1 block text-sm leading-6 text-sand-600">{body}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <div class="mt-6 border-t border-ink pt-4 font-display text-base italic text-sand-600">Todo servido desde un solo panel.</div>
          </div>
        </div>
      </section>

      <!-- EL PANEL: the backoffice, view by view -->
      <section id="screenshots" class="relative scroll-mt-24 overflow-hidden bg-brand-50" data-tone="peach">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
          <div class="max-w-2xl">
            <span class={`${eyebrow} text-brand-700`}>El panel</span>
            <h2 class={`mt-4 ${h2}`}>Mira {APP_NAME} <em>en acción</em></h2>
            <p class="mt-4 text-lg leading-8 text-sand-600">Un vistazo a lo que ven tú y tu equipo todos los días.</p>
          </div>

          <div class="mt-9 lg:max-w-[980px]" data-tabs>
            <div class="no-scrollbar -mx-4 flex gap-8 overflow-x-auto border-b border-sand-300 px-4 text-[15px] font-medium sm:mx-0 sm:px-0" role="tablist" aria-label="Vistas del panel">
              {panelTabs.map((tab) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${tab.id}`}
                  aria-selected={tab.id === defaultTab ? 'true' : 'false'}
                  aria-controls={`panel-${tab.id}`}
                  tabindex={tab.id === defaultTab ? 0 : -1}
                  class="-mb-px inline-flex h-12 shrink-0 items-center whitespace-nowrap border-b-2 border-transparent text-sand-600 transition-colors hover:text-ink aria-selected:border-brand-700 aria-selected:font-semibold aria-selected:text-ink"
                >{tab.label}</button>
              ))}
            </div>

            <div class="relative mt-8">
              <div id="panel-sales" role="tabpanel" aria-labelledby="tab-sales" hidden={defaultTab !== 'sales'}><AppFrame variant="window"><img src="/assets/img/screenshots/03-sales-kpis.webp" alt="Estadísticas de ventas en Cheflink" width="2560" height="3280" loading="lazy" /></AppFrame></div>
              <div id="panel-menu" role="tabpanel" aria-labelledby="tab-menu" hidden={defaultTab !== 'menu'}><AppFrame variant="window"><img src="/assets/img/screenshots/04-backoffice-menu.webp" alt="Administración del menú en Cheflink" width="2560" height="1600" loading="lazy" /></AppFrame></div>
              <div id="panel-kitchen" role="tabpanel" aria-labelledby="tab-kitchen" hidden={defaultTab !== 'kitchen'}><AppFrame variant="window"><img src="/assets/img/screenshots/01-kds-board.webp" alt="Kitchen Display System de Cheflink" width="2560" height="1600" loading="eager" /></AppFrame></div>
              <div id="panel-inventory" role="tabpanel" aria-labelledby="tab-inventory" hidden={defaultTab !== 'inventory'}><AppFrame variant="window"><img src="/assets/img/screenshots/05-backoffice-inventory.webp" alt="Manejo de inventario en Cheflink" width="2560" height="1600" loading="lazy" /></AppFrame></div>
              <div id="panel-floor" role="tabpanel" aria-labelledby="tab-floor" hidden={defaultTab !== 'floor'}><AppFrame variant="window"><img src="/assets/img/screenshots/02-kds-floor.webp" alt="Vista del salón en Cheflink" width="2560" height="1600" loading="lazy" /></AppFrame></div>
            </div>
          </div>
        </div>

        <div class="absolute bottom-16 right-[max(1rem,calc((100vw-80rem)/2+2rem))] hidden w-[250px] xl:block">
          <div class="mb-3 ml-8 -rotate-3 font-hand text-[22px] leading-none text-sand-700" aria-hidden="true">y esto ve tu cliente<svg class="ml-10 mt-1 h-[58px] w-[40px]" viewBox="0 0 40 58" fill="none"><path d="M6 3c16 8 22 24 18 48" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 41l10 11 9-13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <PhoneFrame tilt={3}><img src="/assets/img/screenshots/09-consumer-paid-tab.webp" alt="Cuenta pagada desde el teléfono del cliente" width="1170" height="2532" loading="lazy" /></PhoneFrame>
        </div>
      </section>

      <!-- LA EXPERIENCIA DEL CLIENTE -->
      <section id="consumer-view" class="scroll-mt-24 bg-cream" data-tone="cream">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
          <div class="max-w-2xl">
            <span class={`${eyebrow} text-brand-700`}>La experiencia del cliente</span>
            <h2 class={`mt-4 ${h2}`}>Lo que ven <em>tus clientes</em></h2>
            <p class="mt-4 text-lg leading-8 text-sand-600">
              Sin descargas, sin cuentas. Escanean el QR de la mesa y en segundos están viendo tu menú, haciendo su pedido y siguiendo su estado, todo desde el navegador de su teléfono.
            </p>
          </div>

          <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 lg:grid-cols-4">
            {[
              ['Menú', 'Escanean y piden desde la mesa.', '06-consumer-menu.webp', 2532],
              ['Tu cuenta', 'Cada plato con su estado, hasta pagar.', '08-consumer-tab.webp', 2532],
              ['Domicilio', 'Piden desde tu menú y siguen al repartidor.', '12-consumer-delivery.webp', 5256],
              ['Reservas', 'Eligen día, hora y personas en línea.', '10-table-reservation.webp', 2895],
            ].map(([label, caption, file, height]) => (
              <figure class="m-0 flex flex-col items-center gap-4">
                <PhoneFrame class="w-full max-w-[250px]"><img src={`/assets/img/screenshots/${file}`} alt={`${label}: ${caption}`} width="1170" height={height} loading="lazy" /></PhoneFrame>
                <figcaption class="text-center">
                  <span class="block font-mono text-xs font-semibold uppercase tracking-[0.12em] text-ink">{label}</span>
                  <span class="mt-1 block text-sm text-sand-600">{caption}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>

        <!-- PRUEBA LA EXPERIENCIA DEL CLIENTE: a placemat on the tablecloth -->
        <div id="try-demo" class="gingham scroll-mt-24 px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
          <div class="mx-auto flex max-w-[1040px] flex-col items-center gap-10 border border-sand-300 bg-paper px-6 py-10 shadow-[0_24px_40px_-28px_rgba(28,23,20,0.45)] sm:px-10 md:flex-row md:gap-16 md:px-20 md:py-14">
            <TableTent lang="es" title="Mesa de prueba" qr="/assets/img/demo_table_qr.svg" size="md" href={demoMenuUrl} class="shrink-0" />
            <div class="flex flex-col items-start gap-3.5">
              <span class={`${eyebrow} text-brand-700`}>Pruébalo tú mismo</span>
              <h3 class="font-display text-[2.1rem] font-normal leading-[1.08] tracking-[-0.02em] sm:text-[2.5rem]">Escanea y pide como un cliente real</h3>
              <p class="max-w-[34em] text-base leading-relaxed text-sand-600">Apunta la cámara de tu teléfono al código para abrir nuestro menú de demostración en vivo, en una mesa real. Sin app, sin registro.</p>
              <div class="mt-2 flex flex-wrap items-center gap-5">
                <a href={demoMenuUrl} target="_blank" rel="noopener" class="inline-flex h-12 items-center rounded-full bg-brand-700 px-6 text-[15px] font-semibold text-white shadow-[0_3px_0_#7C2D12] transition-colors hover:bg-brand-800">Abrir demo en vivo</a>
                <span class="text-sm text-sand-600">Mejor desde tu teléfono</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PRECIOS (oculto por ahora) -->
      <section id="pricing" class="hidden mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="mx-auto max-w-2xl text-center">
          <span class={`${eyebrow} text-brand-700`}>Precios</span>
          <h2 class={`mt-4 ${h2}`}>Precios que crecen contigo</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">Empieza gratis y migra a cualquier otro plan cuando quieras usar {APP_NAME} en todas tus mesas y sucursales.</p>
        </div>
        <div class="mt-12 grid items-start gap-6 md:grid-cols-3">
          {[
            ['Starter', 'Ideal para probar.', '$0', ['1 local con 1 mesa', '1 usuario', '10 items de menú', '5 pedidos al día', 'Kitchen Display System (KDS)'], false],
            ['Premium', 'Ideal para negocios pequeños y medianos.', '$99', ['1 local con mesas ilimitadas', 'Usuarios ilimitados', 'Items de menú ilimitados', 'Pedidos ilimitados', 'Kitchen Display System (KDS)', 'Facturación', 'Cierres', 'Dashboard de ventas', 'Reportes', 'Soporte prioritario'], true],
            ['Diamond', 'Ideal para negocios grandes.', '', ['Locales ilimitados con mesas ilimitadas', 'Cobros Digitales', 'Pedidos online', 'Programas de Fidelidad', 'Manejo de Inventario', 'Onboarding completo'], false],
          ].map(([name, tagline, price, items, featured]) => (
            <div class={`flex flex-col justify-between border bg-paper p-7 ${featured ? 'border-ink' : 'border-sand-300'}`}>
              <div>
                <h3 class="font-display text-2xl">{name}</h3>
                <p class="mt-1 text-sm text-sand-600">{tagline}</p>
                {price && <div class="mt-5 flex items-baseline gap-1"><span class="font-display text-4xl">{price}</span><span class="text-sm text-sand-500">/ mes</span></div>}
                <ul class="mt-6 space-y-2 text-sm text-sand-700">{(items as string[]).map((item) => <li class="border-t border-dotted border-sand-300 pt-2">{item}</li>)}</ul>
              </div>
              <a href={`/es/demo/?plan=${name}`} class={`mt-7 inline-flex h-11 items-center justify-center rounded-full text-sm font-semibold ${featured ? 'bg-brand-700 text-white hover:bg-brand-800' : 'border border-sand-300 text-ink hover:bg-sand-50'}`}>Contáctanos</a>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="scroll-mt-24 bg-sand-100" data-tone="sand">
        <div class="mx-auto grid max-w-7xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-6 lg:px-8 lg:py-28">
          <div class="flex flex-col gap-4 lg:col-span-4 lg:pr-6">
            <h2 class={h2}>Preguntas <em>frecuentes</em></h2>
            <p class="text-base leading-relaxed text-sand-600">Algunas respuestas rápidas. Siempre puedes escribirnos si necesitas más detalles.</p>
          </div>
          <div class="lg:col-span-8">
            {faq.map(([q, a], i) => (
              <details class={`group border-t py-5 last:border-b last:border-b-sand-300 ${i === 0 ? 'border-t-ink' : 'border-t-sand-300'}`} open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-[23px] font-medium tracking-[-0.01em] marker:hidden [&::-webkit-details-marker]:hidden">
                  {q}
                  <svg class="h-5 w-5 shrink-0 text-sand-500 transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </summary>
                <p class="mt-3 max-w-[42em] text-base leading-relaxed text-sand-600">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="bg-brand-100 text-ink" data-tone="apricot">
        <div class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-8 lg:pt-28">
          <h2 class="max-w-[14em] font-display text-[2.6rem] font-normal leading-[1.03] tracking-[-0.03em] sm:text-6xl lg:text-[4.25rem]">¿Listo para que cada mesa <em class="text-brand-700">se atienda sola?</em></h2>
          <p class="mt-6 max-w-[34em] text-lg leading-[1.6] text-sand-600">Agenda una demo rápida y te lo mostramos, o prueba el menú de demostración en vivo ahora mismo.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-3 pb-20 lg:pb-24">
            <a href="/es/demo/" class={btnPrimary}>Agendar demo</a>
            <a href={demoMenuUrl} target="_blank" rel="noopener" class={`${btnLink} text-ink`}>Pruébalo tú mismo</a>
          </div>
        </div>
      </section>
    </main>

    <Footer lang="es" />
  </div>

  <script src="/assets/js/landing.js" defer></script>
  <script src="/assets/js/pixel-scenes.js" defer></script>
</BaseLayout>
