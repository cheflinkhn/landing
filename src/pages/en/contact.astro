---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import { CALENDLY_URL } from '../../config/calendly';
---

<BaseLayout
  lang="en"
  title="Cheflink - Book a Demo"
  description="Schedule a Google Meet call to see how Cheflink can help your restaurant."
  canonicalPath="/en/contact/"
>
<div class="min-h-screen bg-cream text-ink">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[420px] overflow-hidden">
    <div class="absolute left-1/2 top-0 h-[460px] w-[1000px] -translate-x-1/2 rounded-b-[50%] bg-gradient-to-b from-clay-100 via-clay-50 to-transparent"></div>
  </div>

  <Navbar lang="en" currentPage="contact" />

  <main class="relative z-10">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-xs font-semibold uppercase tracking-wider text-clay-600">Talk to us</span>
        <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Book a demo</h1>
        <p class="mt-4 text-lg leading-8 text-sand-600">Pick a time that works for you and we'll meet over Google Meet. The meeting link is sent to you automatically when you book.</p>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-5">
        <aside class="lg:col-span-2">
          <div class="rounded-2xl border border-sand-200 bg-white p-6 shadow-soft">
            <h2 class="text-base font-semibold text-ink">What to expect</h2>
            <ul class="mt-4 space-y-3 text-sm text-sand-600">
              <li class="flex gap-3"><span class="mt-1.5 inline-block h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></span>A walkthrough of Cheflink tailored to your restaurant</li>
              <li class="flex gap-3"><span class="mt-1.5 inline-block h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></span>Answers about pricing, setup, and onboarding</li>
              <li class="flex gap-3"><span class="mt-1.5 inline-block h-2 w-2 flex-shrink-0 rounded-full bg-clay-500"></span>A Google Meet link delivered automatically once you book</li>
            </ul>
          </div>
        </aside>

        <section class="lg:col-span-3">
          <div class="rounded-2xl border border-sand-200 bg-white p-3 shadow-soft sm:p-4">
            <div id="calendly-embed" class="min-w-[280px] overflow-hidden rounded-xl" style="height:760px;">
              <p class="p-6 text-sm text-sand-500">Loading the scheduler… If it doesn't appear, <a class="font-medium text-clay-600 hover:text-clay-700" href={CALENDLY_URL} target="_blank" rel="noopener">open it in a new tab</a>.</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <footer class="relative z-10 border-t border-sand-200">
    <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-sand-500 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p>© <span data-year></span> Cheflink. All rights reserved.</p>
        <div class="flex gap-4">
          <a href="/en/terms/" class="transition-colors hover:text-ink">Terms</a>
          <a href="/en/privacy/" class="transition-colors hover:text-ink">Privacy</a>
        </div>
      </div>
    </div>
  </footer>
</div>

<link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
<script src="https://assets.calendly.com/assets/external/widget.js" async></script>
<script define:vars={{ calendlyUrl: CALENDLY_URL }}>
  (function () {
    const parent = document.getElementById('calendly-embed');
    if (!parent) return;

    // Carry a `?plan=` query param through to Calendly so the chosen plan is
    // tracked with the booking (visible in your Calendly event reporting).
    const plan = (new URLSearchParams(window.location.search).get('plan') || '').trim();

    let url = calendlyUrl + (calendlyUrl.includes('?') ? '&' : '?') + 'hide_gdpr_banner=1';
    if (plan) url += '&utm_content=' + encodeURIComponent(plan);

    function init() {
      if (!window.Calendly) { window.setTimeout(init, 50); return; }
      parent.innerHTML = '';
      window.Calendly.initInlineWidget({ url, parentElement: parent });
    }
    init();
  })();
</script>
</BaseLayout>
