---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
---

<BaseLayout
  lang="en"
  title="Cheflink - Contact Us"
  description="Book a demo or get in touch to learn how Cheflink can help your restaurant."
  canonicalPath="/en/contact/"
>
<div class="min-h-screen bg-white text-slate-900">
  <div class="pointer-events-none fixed inset-0 overflow-hidden">
    <div class="absolute -top-40 left-1/2 h-[520px] w-[820px] -translate-x-1/2 rounded-full bg-orange-300/30 blur-3xl"></div>
    <div class="absolute -bottom-44 right-[-10%] h-[420px] w-[720px] rounded-full bg-sky-200/40 blur-3xl"></div>
  </div>

  <Navbar lang="en" currentPage="contact" />

  <main class="relative z-10">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl">
        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">Contact Us</h1>
        <p class="mt-3 text-base leading-7 text-slate-600">Tell us what you're building or what you need help with. We'll get back to you as soon as possible.</p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-5">
        <aside class="lg:col-span-2">
          <div class="rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-sm">
            <h2 class="text-base font-semibold text-slate-900">What to include</h2>
            <ul class="mt-4 space-y-3 text-sm text-slate-600">
              <li class="flex gap-3"><span class="mt-1 inline-block h-2 w-2 rounded-full bg-orange-500"></span>Your type of business (restaurant, café, bar, etc.)</li>
              <li class="flex gap-3"><span class="mt-1 inline-block h-2 w-2 rounded-full bg-orange-500"></span>Number of locations you manage</li>
              <li class="flex gap-3"><span class="mt-1 inline-block h-2 w-2 rounded-full bg-orange-500"></span>Approximate number of tables and staff users</li>
            </ul>
            <div class="mt-6 border-t border-slate-200 pt-6">
              <h3 class="text-sm font-semibold text-slate-900">Contact via WhatsApp</h3>
              <p class="mt-2 text-sm text-slate-600">
                Prefer to chat on WhatsApp? Send us a message at
                <a class="font-medium text-orange-700 hover:text-orange-600" href="https://wa.link/eh04gu">https://wa.link/eh04gu</a>
              </p>
            </div>
          </div>
        </aside>

        <section class="lg:col-span-3">
          <div class="rounded-2xl border border-slate-200 bg-white/70 p-6 shadow-sm">
            <form name="contact-en" class="space-y-6" netlify>
              <input type="hidden" name="form-name" value="contact-en" />
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="first_name" class="block text-sm font-medium text-slate-700">First name</label>
                  <input id="first_name" name="first_name" type="text" autocomplete="given-name" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" />
                </div>
                <div>
                  <label for="last_name" class="block text-sm font-medium text-slate-700">Last name</label>
                  <input id="last_name" name="last_name" type="text" autocomplete="family-name" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" />
                </div>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="email" class="block text-sm font-medium text-slate-700">Email</label>
                  <input id="email" name="email" type="email" autocomplete="email" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" />
                </div>
                <div>
                  <label for="country" class="block text-sm font-medium text-slate-700">Country</label>
                  <input id="country" name="country" type="text" autocomplete="country-name" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" />
                </div>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="phone" class="block text-sm font-medium text-slate-700">Phone number</label>
                  <input id="phone" name="phone" type="tel" autocomplete="tel" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15" />
                  <p class="mt-2 text-xs text-slate-500">Include your country code if possible.</p>
                </div>
                <div>
                  <label for="plan" class="block text-sm font-medium text-slate-700">Plan</label>
                  <select id="plan" name="plan" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15">
                    <option value="" disabled selected>Select a plan</option>
                    <option value="Starter">Starter</option>
                    <option value="Premium">Premium</option>
                    <option value="Diamond">Diamond</option>
                  </select>
                </div>
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-slate-700">Message</label>
                <textarea id="message" name="message" rows="6" required class="mt-2 block w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 shadow-sm outline-none focus:border-orange-500 focus:ring-4 focus:ring-orange-500/15"></textarea>
              </div>
              <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-xs text-slate-500">By submitting this form, you agree that Cheflink may contact you regarding your inquiry.</p>
                <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-orange-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-orange-600/20 hover:bg-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/40">Send</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
  </main>

  <footer class="relative z-10 border-t border-slate-200/70">
    <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-slate-500 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p>© <span data-year></span> Cheflink. All rights reserved.</p>
        <div class="flex gap-4">
          <a href="/en/terms/" class="hover:text-slate-900">Terms</a>
          <a href="/en/privacy/" class="hover:text-slate-900">Privacy</a>
        </div>
      </div>
    </div>
  </footer>
</div>

<script>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const planFromUrl = (params.get('plan') || '').trim();
    if (!planFromUrl) return;
    const select = document.getElementById('plan') as HTMLSelectElement | null;
    if (!select) return;
    const hasOption = Array.from(select.options).some(opt => opt.value === planFromUrl);
    if (hasOption) { select.value = planFromUrl; return; }
    const opt = document.createElement('option');
    opt.value = planFromUrl;
    opt.textContent = planFromUrl;
    select.appendChild(opt);
    select.value = planFromUrl;
  })();
</script>
</BaseLayout>
