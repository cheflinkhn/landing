---
import { APP_NAME } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Ticket from '../../components/Ticket.astro';
import StreetScene from '../../components/StreetScene.astro';
import TableTent from '../../components/TableTent.astro';
import AppFrame from '../../components/AppFrame.astro';
import PhoneFrame from '../../components/PhoneFrame.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: APP_NAME,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'Restaurant operating system: QR or waiter ordering, real-time kitchen display, table tabs, invoicing, inventory and reports in a single dashboard.',
  url: 'https://cheflink.io/en/',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '0',
      priceCurrency: 'USD',
      description: '1 venue with 1 table, 1 user, 10 menu items, 5 orders per day',
    },
    {
      '@type': 'Offer',
      name: 'Premium',
      price: '99',
      priceCurrency: 'USD',
      description: '1 venue with unlimited tables, unlimited users, unlimited orders, KDS, invoicing, sales dashboard',
    },
  ],
};

const faq = [
  ['Do guests have to download an app?', `No. They scan the table's QR code and ${APP_NAME} opens in the browser. From there they can browse the menu, place orders, and everything is linked to that table's tab.`],
  ['Do guests always have to order by scanning the QR code?', `No. Your servers can take and enter orders themselves in ${APP_NAME}, as they always have. Every tab and order, whether it came from the QR or from a server, follows the same flow: it reaches the kitchen, lands on the table's tab, and is charged the same way.`],
  [`Can I use ${APP_NAME} across several locations?`, 'Yes. On the Diamond plan you can run unlimited venues with unlimited tables.'],
  ['Can each venue have a different menu?', 'Yes. You keep one main catalog with all your dishes, and each venue builds its own menu from it: it picks what it offers, with its own prices and availability, without re-entering anything.'],
  [`Does ${APP_NAME} replace my POS?`, `You can run ${APP_NAME} alongside your current point-of-sale system, or connect a digital payments provider to charge guests directly from the system.`],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
};

// The features as three pillars: the three places in a restaurant that have to
// talk to each other. QR ordering is one line under Floor, not the headline.
const pillars = [
  { name: 'Floor', where: 'Where guests are served', items: [
    ['QR or waiter ordering', 'Guests order from their phone with no app, or your team takes it on theirs.'],
    ['Table tabs and payments', 'Discounts, service charges, and payment from the phone or at the register.'],
    ['Floor view', 'Which table is waiting for what, and for how long, at a glance.'],
    ['Online reservations', 'Guests book from your page and the floor already knows who is coming.'],
    ['Delivery orders', 'From your own menu, with the guest\'s location and courier tracking.'],
    ['Loyalty program', 'Points and perks recorded on their own at every visit.'],
  ] },
  { name: 'Kitchen', where: 'Where food gets made', items: [
    ['Kitchen Display System', 'Every ticket with its status, in real time, on any screen.'],
    ['Inventory', 'Live stock, low-level alerts, and a menu that matches what you have.'],
    ['Waste', 'Log what is lost or thrown out, with a reason and its cost, and it comes off the stock on the spot.'],
    ['Warehouses', 'Receive supplier deliveries into a central store and supply each venue through internal stock requests.'],
  ] },
  { name: 'Back office', where: 'Where the business runs', items: [
    ['Invoicing', 'Tax-compliant invoices and receipts with taxes and service already applied.'],
    ['Closures and reports', 'X and Z reports, sales, best sellers, peak hours and per-table performance.'],
    ['Staff and permissions', 'Roles for who takes orders, edits the menu or closes tabs.'],
    ['Multiple venues', 'All your locations under one account.'],
  ] },
];

const panelTabs = [
  { id: 'sales', label: 'Sales' },
  { id: 'menu', label: 'Menu management' },
  { id: 'kitchen', label: 'Kitchen (KDS)' },
  { id: 'inventory', label: 'Inventory' },
  { id: 'floor', label: 'Floor view' },
];
const defaultTab = 'kitchen';

// Live demo venue table — every scan opens its own isolated tab.
const demoMenuUrl = 'https://app.cheflink.io/t/757_iu-h/';

const eyebrow = 'font-mono text-xs font-medium uppercase tracking-[0.14em]';
const h2 = 'font-display text-[2.4rem] font-normal leading-[1.05] tracking-[-0.025em] sm:text-5xl lg:text-[3.5rem]';
const btnPrimary = 'inline-flex h-[54px] items-center justify-center rounded-full bg-brand-700 px-8 text-base font-semibold text-white shadow-[0_3px_0_#7C2D12] transition-colors hover:bg-brand-800';
const btnLink = 'inline-flex min-h-[44px] items-center font-semibold underline decoration-[1.5px] underline-offset-[6px]';
---

<BaseLayout
  lang="en"
  title={`${APP_NAME} - The Restaurant Operating System`}
  description={`${APP_NAME} is the restaurant operating system: QR or waiter orders, real-time kitchen screens, tabs, invoicing, inventory and reports in one dashboard.`}
  canonicalPath="/en/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="min-h-screen bg-cream text-ink">
    <Navbar lang="en" currentPage="index" />

    <main>
      <!-- HERO: copy, the kitchen board as the cook sees it, and the night's tickets on the rail -->
      <section id="hero" class="relative bg-dawn" data-tone="dawn">
        <div class="mx-auto grid max-w-7xl gap-12 px-4 pb-4 pt-10 sm:px-6 lg:grid-cols-12 lg:items-start lg:gap-6 lg:px-8 lg:pt-14">
          <div class="flex flex-col items-start lg:col-span-6">
            <span class={`${eyebrow} text-sand-600`}>The restaurant operating system</span>
            <h1 class="mt-5 font-display text-[2.75rem] font-normal leading-[1] tracking-[-0.03em] sm:text-6xl lg:text-[4.9rem]">
              Your whole restaurant, <em class="text-brand-700">in one system.</em>
            </h1>
            <p class="mt-6 max-w-[34em] text-lg leading-[1.6] text-sand-600">
              {APP_NAME} connects your floor, kitchen and back office in one real-time dashboard: QR or waiter orders, reservations, kitchen screens, tabs, invoicing, inventory and reports, with no loose tools and nothing typed twice.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3">
              <a href="/en/demo/" class={btnPrimary}>Book a demo</a>
              <a href="#try-demo" class={`${btnLink} text-ink`}>Try it yourself</a>
            </div>
            <div class="mt-9 flex flex-wrap gap-x-6 gap-y-2 border-t border-sand-300 pt-5 text-sm text-sand-600">
              <span>No app for your guests</span>
              <span>Works alongside your POS</span>
            </div>
          </div>

          <div class="relative lg:col-span-6">
            <div class="relative mx-auto max-w-[590px] pb-8 pl-6 pt-8 sm:pl-10 lg:ml-auto lg:mr-0 lg:pt-10">
              <div class="absolute -top-1 right-4 hidden -rotate-3 items-start gap-1.5 font-hand text-[21px] leading-none text-sand-700 lg:flex" aria-hidden="true">
                what the kitchen sees
                <svg class="mt-2 h-[50px] w-[46px]" viewBox="0 0 46 50" fill="none"><path d="M3 4c14 1 27 9 31 38" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M25 33l9 10 7-12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <AppFrame variant="tablet">
                <img src="/assets/img/screenshots/11-kds-board-tablet.webp" alt="Cheflink Kitchen Display System" width="2048" height="1536" loading="eager" />
              </AppFrame>
              <div class="absolute bottom-0 left-0 w-[104px] sm:w-[128px] lg:-left-3">
                <PhoneFrame>
                  <img src="/assets/img/screenshots/06-consumer-menu.webp" alt="Guest menu view in Cheflink" width="1170" height="2532" loading="eager" />
                </PhoneFrame>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-8 lg:mt-4">
          <StreetScene lang="en" />
        </div>
      </section>

      <!-- TRUST + HOW IT WORKS: on the dark ground the tickets hang into -->
      <section id="how-it-works" class="scroll-mt-24 bg-sand-100 text-ink" data-tone="sand">
        <div class="mx-auto max-w-7xl px-4 pb-20 pt-16 sm:px-6 lg:px-8 lg:pb-28 lg:pt-20">
          <div class="grid gap-6 border-b border-dashed border-sand-400 pb-10 sm:grid-cols-2 lg:grid-cols-4">
            {[
              ['No new hardware', 'Runs on the phones and screens you already have.'],
              ['Works alongside your POS', 'Use it next to your current point of sale, or charge straight from the system.'],
              ['Live in a day', 'Build your menu, print the codes, start taking orders.'],
              ['Built for service', 'Designed around how busy floors actually run.'],
            ].map(([title, body]) => (
              <div class="flex flex-col gap-1.5">
                <span class="text-[15px] font-semibold">{title}</span>
                <span class="text-sm leading-6 text-sand-600">{body}</span>
              </div>
            ))}
          </div>

          <div class="mt-16 max-w-2xl">
            <span class={`${eyebrow} text-brand-700`}>How it works</span>
            <h2 class={`mt-4 ${h2}`}>A service flow in <em>three steps</em></h2>
          </div>

          <div class="relative mt-12 grid gap-12 md:grid-cols-3 md:gap-6">
            <svg class="absolute left-0 top-[140px] hidden h-[120px] w-full md:block" viewBox="0 0 1280 120" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M120 70C260 10 330 110 520 60S800 20 940 70s180 20 260-10" stroke="#A99685" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 11"/></svg>

            <div class="relative flex flex-col gap-7">
              <div class="flex h-[300px] items-center pl-4 md:h-[330px]">
                <TableTent lang="en" table="7" qr="/assets/img/landing_qr.png" />
              </div>
              <div class="flex max-w-[350px] flex-col gap-2">
                <span class="font-display text-2xl italic text-brand-700">1. The table</span>
                <h3 class="text-[19px] font-semibold">Guests order however they like</h3>
                <p class="text-[15px] leading-6 text-sand-600">They scan the table's QR and order from their phone, or the waiter takes it on theirs. Reservations land on the same floor plan.</p>
              </div>
            </div>

            <div class="relative flex flex-col gap-7">
              <div class="flex h-[300px] items-center pl-4 md:h-[330px]">
                <Ticket title="TABLE 07" meta="8:41 PM" lines={['2× Burger', '1× Truffle fries', '1× Lemonade']} note="no onions" status="New" statusTone="accent" size="md" clip={false} tornTop tilt={2.5} shadow="rgba(28,23,20,0.22)" />
              </div>
              <div class="flex max-w-[350px] flex-col gap-2">
                <span class="font-display text-2xl italic text-brand-700">2. The ticket</span>
                <h3 class="text-[19px] font-semibold">The kitchen sees it instantly</h3>
                <p class="text-[15px] leading-6 text-sand-600">Every dish shows up on the kitchen screen with its status, and inventory counts itself down.</p>
              </div>
            </div>

            <div class="relative flex flex-col gap-7">
              <div class="flex h-[300px] items-center pl-4 md:h-[330px]">
                <Ticket title="CHECK" meta="#1042" rows={[{ label: 'Burger ×2', value: '$24.00' }, { label: 'Truffle fries', value: '$9.00' }, { label: 'Service 10%', value: '$3.30' }]} total={{ label: 'Total', value: '$36.30' }} stamp="PAID" stampTone="ok" size="md" clip={false} tilt={-2} shadow="rgba(28,23,20,0.22)" />
              </div>
              <div class="flex max-w-[350px] flex-col gap-2">
                <span class="font-display text-2xl italic text-brand-700">3. The check</span>
                <h3 class="text-[19px] font-semibold">Get paid, invoice, close the day</h3>
                <p class="text-[15px] leading-6 text-sand-600">The tab is paid from the table or at the register, goes out with an invoice, and sales and reports are ready without typing anything.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- FEATURES: three pillars, the three parts of the house -->
      <section id="features" class="scroll-mt-24 bg-cream" data-tone="cream">
        <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-6 lg:px-8 lg:py-28">
          <div class="flex flex-col gap-4 lg:col-span-4 lg:pr-6">
            <span class={`${eyebrow} text-brand-700`}>Features</span>
            <h2 class={h2}>Everything you need in <em>one place</em></h2>
            <p class="mt-2 text-[17px] leading-7 text-sand-600">
              A restaurant is three places that have to talk to each other: the floor, the kitchen and the office. {APP_NAME} connects them in one system, and QR ordering is just one of the doors in.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="h-1 border-b border-t border-ink" aria-hidden="true"></div>
            <div class="grid gap-x-8 gap-y-10 pt-7 md:grid-cols-3">
              {pillars.map((p) => (
                <div class="flex flex-col">
                  <span class={`${eyebrow} text-sand-600`}>{p.where}</span>
                  <h3 class="mt-2 font-display text-[30px] font-normal leading-none tracking-[-0.02em]">{p.name}</h3>
                  <ul class="mt-5 flex flex-col">
                    {p.items.map(([title, body]) => (
                      <li class="border-t border-sand-200 py-4">
                        <span class="block text-[15px] font-semibold">{title}</span>
                        <span class="mt-1 block text-sm leading-6 text-sand-600">{body}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <div class="mt-6 border-t border-ink pt-4 font-display text-base italic text-sand-600">All served from a single dashboard.</div>
          </div>
        </div>
      </section>

      <!-- THE DASHBOARD: the backoffice, view by view -->
      <section id="screenshots" class="relative scroll-mt-24 overflow-hidden bg-brand-50" data-tone="peach">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
          <div class="max-w-2xl">
            <span class={`${eyebrow} text-brand-700`}>The dashboard</span>
            <h2 class={`mt-4 ${h2}`}>See {APP_NAME} <em>in action</em></h2>
            <p class="mt-4 text-lg leading-8 text-sand-600">A look at what you and your team see every day.</p>
          </div>

          <div class="mt-9 lg:max-w-[980px]" data-tabs>
            <div class="no-scrollbar -mx-4 flex gap-8 overflow-x-auto border-b border-sand-300 px-4 text-[15px] font-medium sm:mx-0 sm:px-0" role="tablist" aria-label="Dashboard views">
              {panelTabs.map((tab) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${tab.id}`}
                  aria-selected={tab.id === defaultTab ? 'true' : 'false'}
                  aria-controls={`panel-${tab.id}`}
                  tabindex={tab.id === defaultTab ? 0 : -1}
                  class="-mb-px inline-flex h-12 shrink-0 items-center whitespace-nowrap border-b-2 border-transparent text-sand-600 transition-colors hover:text-ink aria-selected:border-brand-700 aria-selected:font-semibold aria-selected:text-ink"
                >{tab.label}</button>
              ))}
            </div>

            <div class="relative mt-8">
              <div id="panel-sales" role="tabpanel" aria-labelledby="tab-sales" hidden={defaultTab !== 'sales'}><AppFrame variant="window"><img src="/assets/img/screenshots/03-sales-kpis.webp" alt="Sales statistics in Cheflink" width="2560" height="3280" loading="lazy" /></AppFrame></div>
              <div id="panel-menu" role="tabpanel" aria-labelledby="tab-menu" hidden={defaultTab !== 'menu'}><AppFrame variant="window"><img src="/assets/img/screenshots/04-backoffice-menu.webp" alt="Menu management in Cheflink" width="2560" height="1600" loading="lazy" /></AppFrame></div>
              <div id="panel-kitchen" role="tabpanel" aria-labelledby="tab-kitchen" hidden={defaultTab !== 'kitchen'}><AppFrame variant="window"><img src="/assets/img/screenshots/01-kds-board.webp" alt="Cheflink Kitchen Display System" width="2560" height="1600" loading="eager" /></AppFrame></div>
              <div id="panel-inventory" role="tabpanel" aria-labelledby="tab-inventory" hidden={defaultTab !== 'inventory'}><AppFrame variant="window"><img src="/assets/img/screenshots/05-backoffice-inventory.webp" alt="Inventory management in Cheflink" width="2560" height="1600" loading="lazy" /></AppFrame></div>
              <div id="panel-floor" role="tabpanel" aria-labelledby="tab-floor" hidden={defaultTab !== 'floor'}><AppFrame variant="window"><img src="/assets/img/screenshots/02-kds-floor.webp" alt="Floor view in Cheflink" width="2560" height="1600" loading="lazy" /></AppFrame></div>
            </div>
          </div>
        </div>

        <div class="absolute bottom-16 right-[max(1rem,calc((100vw-80rem)/2+2rem))] hidden w-[250px] xl:block">
          <div class="mb-3 ml-8 -rotate-3 font-hand text-[22px] leading-none text-sand-700" aria-hidden="true">and this is your guest's view<svg class="ml-10 mt-1 h-[58px] w-[40px]" viewBox="0 0 40 58" fill="none"><path d="M6 3c16 8 22 24 18 48" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 41l10 11 9-13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <PhoneFrame tilt={3}><img src="/assets/img/screenshots/09-consumer-paid-tab.webp" alt="A tab paid from the guest's phone" width="1170" height="2532" loading="lazy" /></PhoneFrame>
        </div>
      </section>

      <!-- THE GUEST EXPERIENCE -->
      <section id="consumer-view" class="scroll-mt-24 bg-cream" data-tone="cream">
        <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
          <div class="max-w-2xl">
            <span class={`${eyebrow} text-brand-700`}>The guest experience</span>
            <h2 class={`mt-4 ${h2}`}>What your <em>guests see</em></h2>
            <p class="mt-4 text-lg leading-8 text-sand-600">
              No downloads, no accounts. They scan the table's QR and within seconds they're browsing your menu, placing their order, and tracking its status, all from their phone's browser.
            </p>
          </div>

          <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 lg:grid-cols-4">
            {[
              ['Menu', 'Scan and order from the table.', '06-consumer-menu.webp', 2532],
              ['Your tab', 'Every dish with its status, through to payment.', '08-consumer-tab.webp', 2532],
              ['Delivery', 'Order from your menu and follow the rider.', '12-consumer-delivery.webp', 5256],
              ['Reservations', 'Pick a day, time and party size online.', '10-table-reservation.webp', 2895],
            ].map(([label, caption, file, height]) => (
              <figure class="m-0 flex flex-col items-center gap-4">
                <PhoneFrame class="w-full max-w-[250px]"><img src={`/assets/img/screenshots/${file}`} alt={`${label}: ${caption}`} width="1170" height={height} loading="lazy" /></PhoneFrame>
                <figcaption class="text-center">
                  <span class="block font-mono text-xs font-semibold uppercase tracking-[0.12em] text-ink">{label}</span>
                  <span class="mt-1 block text-sm text-sand-600">{caption}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>

        <!-- TRY THE GUEST EXPERIENCE: a placemat on the tablecloth -->
        <div id="try-demo" class="gingham scroll-mt-24 px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
          <div class="mx-auto flex max-w-[1040px] flex-col items-center gap-10 border border-sand-300 bg-paper px-6 py-10 shadow-[0_24px_40px_-28px_rgba(28,23,20,0.45)] sm:px-10 md:flex-row md:gap-16 md:px-20 md:py-14">
            <TableTent lang="en" title="Demo table" qr="/assets/img/demo_table_qr.svg" size="md" href={demoMenuUrl} class="shrink-0" />
            <div class="flex flex-col items-start gap-3.5">
              <span class={`${eyebrow} text-brand-700`}>Try it yourself</span>
              <h3 class="font-display text-[2.1rem] font-normal leading-[1.08] tracking-[-0.02em] sm:text-[2.5rem]">Scan and order like a real guest</h3>
              <p class="max-w-[34em] text-base leading-relaxed text-sand-600">Point your phone's camera at the code to open our live demo menu, on a real table. No app, no sign-up.</p>
              <div class="mt-2 flex flex-wrap items-center gap-5">
                <a href={demoMenuUrl} target="_blank" rel="noopener" class="inline-flex h-12 items-center rounded-full bg-brand-700 px-6 text-[15px] font-semibold text-white shadow-[0_3px_0_#7C2D12] transition-colors hover:bg-brand-800">Open the live demo</a>
                <span class="text-sm text-sand-600">Best from your phone</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PRICING (hidden for now) -->
      <section id="pricing" class="hidden mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="mx-auto max-w-2xl text-center">
          <span class={`${eyebrow} text-brand-700`}>Pricing</span>
          <h2 class={`mt-4 ${h2}`}>Pricing that grows with you</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">Start free and move to any other plan when you want {APP_NAME} on every table and location.</p>
        </div>
        <div class="mt-12 grid items-start gap-6 md:grid-cols-3">
          {[
            ['Starter', 'Ideal for trying it out.', '$0', ['1 venue with 1 table', '1 user', '10 menu items', '5 orders per day', 'Kitchen Display System (KDS)'], false],
            ['Premium', 'Ideal for small and medium venues.', '$99', ['1 venue with unlimited tables', 'Unlimited users', 'Unlimited menu items', 'Unlimited orders', 'Kitchen Display System (KDS)', 'Invoicing', 'Closures', 'Sales dashboard', 'Reports', 'Priority support'], true],
            ['Diamond', 'Ideal for large operations.', '', ['Unlimited venues with unlimited tables', 'Digital payments', 'Online orders', 'Loyalty programs', 'Inventory management', 'Full onboarding'], false],
          ].map(([name, tagline, price, items, featured]) => (
            <div class={`flex flex-col justify-between border bg-paper p-7 ${featured ? 'border-ink' : 'border-sand-300'}`}>
              <div>
                <h3 class="font-display text-2xl">{name}</h3>
                <p class="mt-1 text-sm text-sand-600">{tagline}</p>
                {price && <div class="mt-5 flex items-baseline gap-1"><span class="font-display text-4xl">{price}</span><span class="text-sm text-sand-500">/ month</span></div>}
                <ul class="mt-6 space-y-2 text-sm text-sand-700">{(items as string[]).map((item) => <li class="border-t border-dotted border-sand-300 pt-2">{item}</li>)}</ul>
              </div>
              <a href={`/en/demo/?plan=${name}`} class={`mt-7 inline-flex h-11 items-center justify-center rounded-full text-sm font-semibold ${featured ? 'bg-brand-700 text-white hover:bg-brand-800' : 'border border-sand-300 text-ink hover:bg-sand-50'}`}>Contact us</a>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="scroll-mt-24 bg-sand-100" data-tone="sand">
        <div class="mx-auto grid max-w-7xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-6 lg:px-8 lg:py-28">
          <div class="flex flex-col gap-4 lg:col-span-4 lg:pr-6">
            <h2 class={h2}>Frequently asked <em>questions</em></h2>
            <p class="text-base leading-relaxed text-sand-600">A few quick answers. You can always write to us if you need more detail.</p>
          </div>
          <div class="lg:col-span-8">
            {faq.map(([q, a], i) => (
              <details class={`group border-t py-5 last:border-b last:border-b-sand-300 ${i === 0 ? 'border-t-ink' : 'border-t-sand-300'}`} open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-[23px] font-medium tracking-[-0.01em] marker:hidden [&::-webkit-details-marker]:hidden">
                  {q}
                  <svg class="h-5 w-5 shrink-0 text-sand-500 transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </summary>
                <p class="mt-3 max-w-[42em] text-base leading-relaxed text-sand-600">{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="bg-brand-100 text-ink" data-tone="apricot">
        <div class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-8 lg:pt-28">
          <h2 class="max-w-[14em] font-display text-[2.6rem] font-normal leading-[1.03] tracking-[-0.03em] sm:text-6xl lg:text-[4.25rem]">Ready for every table to <em class="text-brand-700">serve itself?</em></h2>
          <p class="mt-6 max-w-[34em] text-lg leading-[1.6] text-sand-600">Book a quick demo and we'll show you around, or try the live demo menu right now.</p>
          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-3 pb-20 lg:pb-24">
            <a href="/en/demo/" class={btnPrimary}>Book a demo</a>
            <a href={demoMenuUrl} target="_blank" rel="noopener" class={`${btnLink} text-ink`}>Try it yourself</a>
          </div>
        </div>
      </section>
    </main>

    <Footer lang="en" />
  </div>

  <script src="/assets/js/landing.js" defer></script>
</BaseLayout>
