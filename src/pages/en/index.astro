---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cheflink',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'QR ordering and table management system for restaurants and bars. Connects QR orders, kitchen display, and table tabs in a single real-time dashboard.',
  url: 'https://cheflink.io/en/',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '0',
      priceCurrency: 'USD',
      description: '1 venue, 1 table, 1 user, 10 menu items, 5 orders per day',
    },
    {
      '@type': 'Offer',
      name: 'Premium',
      price: '99',
      priceCurrency: 'USD',
      description: '1 venue with unlimited tables, unlimited users, unlimited orders, KDS, invoicing, sales dashboard',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does the guest need to download an app?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. They simply scan the QR code at the table and Cheflink opens in the browser. They can view the menu, place orders, and link everything to their table tab.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use Cheflink across multiple locations?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. With the Diamond plan you can use it across unlimited venues with unlimited tables.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Cheflink replace my POS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can use Cheflink alongside your current point-of-sale system, or integrate it with a digital payment provider to collect payment directly through the platform.',
      },
    },
  ],
};
---

<BaseLayout
  lang="en"
  title="Cheflink - QR Ordering for Restaurants and Bars"
  description="Cheflink connects QR orders, kitchen, and table tabs in a single real-time dashboard."
  canonicalPath="/en/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>
<div class="min-h-screen bg-gradient-to-b from-white via-slate-50 to-slate-100">
  <Navbar lang="en" currentPage="index" />

  <main>
    <!-- HERO -->
    <section id="hero" class="mx-auto flex max-w-7xl flex-col gap-12 px-4 pb-16 pt-10 sm:px-6 lg:flex-row lg:items-center lg:gap-16 lg:px-8 lg:pb-24 lg:pt-16">
      <div class="max-w-xl space-y-6 lg:max-w-lg">
        <div class="space-y-4">
          <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
            Your menu can <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">sell more</span> without a word.
          </h1>
          <p class="text-sm text-slate-600 sm:text-base">The problem isn't your staff — it's your system.</p>
          <p class="text-sm text-slate-600 sm:text-base">
            Cheflink connects QR orders, kitchen, and table tabs in a single real-time dashboard. Less running around for staff, more spending per table, and guests who no longer need to flag down a waiter to order or pay.
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            id="signup"
            href="https://app.cheflink.io/signup/"
            class="inline-flex items-center justify-center rounded-full bg-orange-500 px-6 py-2.5 text-sm font-semibold text-white shadow-md shadow-orange-500/40 hover:bg-orange-400"
          >
            Try It Free
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600">
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-500" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5" />
              <path d="M6 10.5 8.5 13 14 7.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>No app required for guests</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-emerald-500" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.5" />
              <path d="M6 10.5 8.5 13 14 7.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Works with your current workflow</span>
          </div>
        </div>

        <div class="mt-2 grid gap-4 text-sm text-slate-700 sm:grid-cols-3">
          <div>
            <div class="text-lg font-semibold text-slate-900">+30%</div>
            <div class="text-xs text-slate-500">faster service during peak hours</div>
          </div>
          <div>
            <div class="text-lg font-semibold text-slate-900">2×</div>
            <div class="text-xs text-slate-500">more orders when the venue fills up</div>
          </div>
          <div>
            <div class="text-lg font-semibold text-slate-900">24/7</div>
            <div class="text-xs text-slate-500">chat and email support</div>
          </div>
        </div>
      </div>

      <div class="relative flex-1 flex items-center justify-center">
        <div class="absolute -left-10 -top-10 h-52 w-52 rounded-full bg-orange-200 blur-3xl" aria-hidden="true"></div>
        <div class="absolute -bottom-10 -right-6 h-40 w-40 rounded-full bg-amber-100 blur-2xl" aria-hidden="true"></div>
        <div class="relative w-full max-w-lg rounded-2xl border border-slate-200 bg-white shadow-2xl overflow-hidden">
          <div class="flex items-center gap-1.5 border-b border-slate-100 bg-slate-50 px-3 py-2">
            <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
            <span class="ml-2 flex-1 rounded-full bg-slate-200 px-3 py-0.5 text-[11px] text-slate-400">app.cheflink.io</span>
          </div>
          <img src="/assets/img/screenshots/kds.png" alt="Cheflink Kitchen Display System" class="w-full block" loading="eager" width="1920" height="1200" />
        </div>
        <div class="absolute -bottom-6 -right-2 sm:right-0 lg:-right-6 w-[100px] sm:w-[118px] overflow-hidden rounded-[1.6rem] border-[5px] border-slate-800 bg-slate-800 shadow-2xl ring-1 ring-white/60">
          <div class="absolute left-1/2 top-0 z-10 h-[12px] w-[40px] -translate-x-1/2 rounded-b-lg bg-slate-800"></div>
          <img src="/assets/img/screenshots/consumer_menu.png" alt="Guest menu view in Cheflink" class="w-full block" loading="eager" width="1449" height="2961" />
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24">
      <div class="mb-10 flex flex-col gap-3 text-center">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Everything you need in one place</h2>
        <p class="mx-auto max-w-2xl text-sm text-slate-600 sm:text-base">
          Cheflink covers the full flow: guests scan a QR, send their orders, and your team sees every ticket and table tab in real time.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex rounded-full bg-orange-50 p-2">
            <svg class="h-5 w-5 text-orange-500" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
          </div>
          <h3 class="text-sm font-semibold text-slate-900">QR menu and ordering</h3>
          <p class="mt-2 text-sm text-slate-600">Guests scan the table code, browse your menu, and send orders from their phone. No app, no sign-up.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex rounded-full bg-orange-50 p-2">
            <svg class="h-5 w-5 text-orange-500" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h4l3 7 3-14 2 7h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
          <h3 class="text-sm font-semibold text-slate-900">Clear kitchen view</h3>
          <p class="mt-2 text-sm text-slate-600">See active tabs and their orders by table in real time. Every item and tab status always visible to your team.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex rounded-full bg-orange-50 p-2">
            <svg class="h-5 w-5 text-orange-500" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 10a7 7 0 0114 0v3a4 4 0 01-4 4H9a4 4 0 01-4-4v-3z" stroke="currentColor" stroke-width="1.7" /><path d="M9 17v1a3 3 0 006 0v-1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
          </div>
          <h3 class="text-sm font-semibold text-slate-900">Table tabs, zero chaos</h3>
          <p class="mt-2 text-sm text-slate-600">Group orders into tabs by table or by guest. View the balance, apply discounts, and mark as paid in one click.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex rounded-full bg-orange-50 p-2">
            <svg class="h-5 w-5 text-orange-500" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 9h14v10H5z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><path d="M3 5h18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
          </div>
          <h3 class="text-sm font-semibold text-slate-900">Multi-location</h3>
          <p class="mt-2 text-sm text-slate-600">Manage multiple venues under a single account.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex rounded-full bg-orange-50 p-2">
            <svg class="h-5 w-5 text-orange-500" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12a8 8 0 0114.32-4.906L21 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><path d="M20 12a8 8 0 01-14.32 4.906L3 19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
          <h3 class="text-sm font-semibold text-slate-900">Real-time updates</h3>
          <p class="mt-2 text-sm text-slate-600">Orders and tabs update automatically. Staff always see the latest list.</p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex rounded-full bg-orange-50 p-2">
            <svg class="h-5 w-5 text-orange-500" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 7h10M7 12h6M7 17h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.7" /></svg>
          </div>
          <h3 class="text-sm font-semibold text-slate-900">Localized for your country</h3>
          <p class="mt-2 text-sm text-slate-600">Configure language, currency, and taxes for your region.</p>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="mx-auto max-w-5xl px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24">
      <div class="mb-8 text-center">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">From scan to payment in three steps</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex h-7 w-7 items-center justify-center rounded-full bg-orange-500 text-xs font-semibold text-white">1</div>
          <h3 class="text-sm font-semibold text-slate-900">Guests scan the table code</h3>
          <p class="mt-2 text-sm text-slate-600">Each table has a unique QR that opens your menu in the guest's browser. No downloads, no friction.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex h-7 w-7 items-center justify-center rounded-full bg-orange-500 text-xs font-semibold text-white">2</div>
          <h3 class="text-sm font-semibold text-slate-900">Orders arrive in Cheflink</h3>
          <p class="mt-2 text-sm text-slate-600">Kitchen and servers see every order in real time. Visual highlight for new tickets.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 inline-flex h-7 w-7 items-center justify-center rounded-full bg-orange-500 text-xs font-semibold text-white">3</div>
          <h3 class="text-sm font-semibold text-slate-900">Close the tab and collect payment</h3>
          <p class="mt-2 text-sm text-slate-600">Apply discounts, service charges, and mark the tab as paid. Cheflink saves the history for every table.</p>
        </div>
      </div>
    </section>

    <!-- SCREENSHOTS -->
    <section id="screenshots" class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24">
      <div class="mb-10 flex flex-col gap-3 text-center">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">See Cheflink in action</h2>
        <p class="mx-auto max-w-xl text-sm text-slate-600 sm:text-base">A real look at what you and your team see every day.</p>
      </div>

      <div class="mb-6 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Dashboard views">
        <button type="button" role="tab" aria-selected="true" aria-controls="tab-panel-1" data-tab="1" class="screenshot-tab rounded-full border border-orange-500 bg-orange-500 px-4 py-1.5 text-sm font-medium text-white transition-colors">Sales Stats</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-2" data-tab="2" class="screenshot-tab rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900">Trends</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-3" data-tab="3" class="screenshot-tab rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900">Sales Detail</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-4" data-tab="4" class="screenshot-tab rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900">Backoffice Menu</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-5" data-tab="5" class="screenshot-tab rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900">Kitchen Display System</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-6" data-tab="6" class="screenshot-tab rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900">Inventory</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-7" data-tab="7" class="screenshot-tab rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900">Floor View</button>
      </div>

      <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
        <div class="flex items-center gap-2 border-b border-slate-100 bg-slate-50 px-4 py-2.5">
          <span class="h-3 w-3 rounded-full bg-red-400"></span>
          <span class="h-3 w-3 rounded-full bg-amber-400"></span>
          <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
          <span class="ml-3 flex-1 rounded-full bg-slate-200 px-3 py-1 text-xs text-slate-400">app.cheflink.io</span>
        </div>
        <div id="tab-panel-1" role="tabpanel"><img src="/assets/img/screenshots/sales1.png" alt="Cheflink dashboard overview" class="w-full" loading="eager" width="1920" height="1200" /></div>
        <div id="tab-panel-2" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/sales2.png" alt="Cheflink sales trends" class="w-full" loading="lazy" width="1920" height="1200" /></div>
        <div id="tab-panel-3" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/sales3.png" alt="Cheflink sales detail" class="w-full" loading="lazy" width="1920" height="1200" /></div>
        <div id="tab-panel-4" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/backoffice_menu.png" alt="Cheflink backoffice menu" class="w-full" loading="lazy" width="1920" height="1200" /></div>
        <div id="tab-panel-5" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/kds.png" alt="Cheflink Kitchen Display System" class="w-full" loading="lazy" width="1920" height="1200" /></div>
        <div id="tab-panel-6" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/inventory.png" alt="Cheflink inventory management" class="w-full" loading="lazy" width="1920" height="994" /></div>
        <div id="tab-panel-7" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/floor_view.png" alt="Cheflink floor view" class="w-full" loading="lazy" width="1920" height="994" /></div>
      </div>
    </section>

    <!-- CONSUMER EXPERIENCE -->
    <section id="consumer-view" class="relative isolate overflow-hidden bg-white py-16 sm:py-24 mb-8">
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute left-1/2 top-0 h-[420px] w-[980px] -translate-x-1/2 rounded-full bg-gradient-to-r from-orange-50 via-amber-50 to-rose-50 blur-3xl"></div>
      </div>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">What your guests see</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            No downloads, no accounts. They scan the table QR and within seconds they're browsing your menu, placing their order, and tracking its status — all from their phone's browser.
          </p>
        </div>

        <div
          class="mt-14 flex flex-col items-center gap-6"
          id="phone-carousel"
          data-labels='["Menu","Add to Cart","Your Cart","Order Status","Tab Paid"]'
        >
          <div class="flex items-center gap-6 sm:gap-10">
            <button type="button" id="carousel-prev" aria-label="Previous" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:border-slate-300 hover:text-slate-900">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="relative overflow-hidden rounded-[2.8rem] border-[8px] border-slate-800 bg-slate-800 shadow-2xl w-[260px] sm:w-[300px]">
              <div class="absolute left-1/2 top-0 z-10 h-[20px] w-[88px] -translate-x-1/2 rounded-b-xl bg-slate-800"></div>
              <div id="carousel-track" class="flex transition-transform duration-300 ease-in-out">
                <img src="/assets/img/screenshots/consumer_menu.png"  alt="Restaurant menu in Cheflink"       class="w-full shrink-0 block" loading="eager" width="1449" height="2961" />
                <img src="/assets/img/screenshots/add_item.png"       alt="Adding item to order in Cheflink"  class="w-full shrink-0 block" loading="lazy"  width="1449" height="2961" />
                <img src="/assets/img/screenshots/cart.png"           alt="Order cart in Cheflink"            class="w-full shrink-0 block" loading="lazy"  width="1449" height="2961" />
                <img src="/assets/img/screenshots/order_progress.png" alt="Order progress in Cheflink"        class="w-full shrink-0 block" loading="lazy"  width="1449" height="2961" />
                <img src="/assets/img/screenshots/tab_paid.png"       alt="Tab paid in Cheflink"              class="w-full shrink-0 block" loading="lazy"  width="1449" height="2961" />
              </div>
            </div>
            <button type="button" id="carousel-next" aria-label="Next" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-500 shadow-sm transition hover:border-slate-300 hover:text-slate-900">
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <p id="carousel-label" class="text-sm font-medium text-slate-700"></p>
          <div class="flex gap-2" id="carousel-dots" role="tablist" aria-label="Guest screens"></div>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="mx-auto max-w-5xl px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24">
      <div class="mb-8 text-center">
        <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Pricing for growing businesses and large operations</h2>
        <p class="mt-2 text-sm text-slate-600 sm:text-base">Start free and upgrade whenever you're ready to use Cheflink across all your tables and locations.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- STARTER -->
        <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div>
            <h3 class="text-sm font-semibold text-slate-900">Starter</h3>
            <p class="mt-1 text-sm text-slate-600">Perfect for trying out Cheflink.</p>
            <div class="mt-4 flex items-baseline gap-1">
              <span class="text-3xl font-semibold text-slate-900">$0</span>
              <span class="text-xs text-slate-500">/ month</span>
            </div>
            <ul class="mt-4 space-y-2 text-sm text-slate-600">
              {['1 venue with 1 table','1 user','10 menu items','5 orders per day','Kitchen Display System (KDS)'].map(item => (
                <li class="flex items-start gap-2">
