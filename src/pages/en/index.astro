---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cheflink',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'QR ordering and table management system for restaurants and bars. Connects QR orders, kitchen display, and table tabs in a single real-time dashboard.',
  url: 'https://cheflink.io/en/',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '0',
      priceCurrency: 'USD',
      description: '1 venue, 1 table, 1 user, 10 menu items, 5 orders per day',
    },
    {
      '@type': 'Offer',
      name: 'Premium',
      price: '99',
      priceCurrency: 'USD',
      description: '1 venue with unlimited tables, unlimited users, unlimited orders, KDS, invoicing, sales dashboard',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does the guest need to download an app?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. They simply scan the QR code at the table and Cheflink opens in the browser. They can view the menu, place orders, and link everything to their table tab.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use Cheflink across multiple locations?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. With the Diamond plan you can use it across unlimited venues with unlimited tables.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Cheflink replace my POS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can use Cheflink alongside your current point-of-sale system, or integrate it with a digital payment provider to collect payment directly through the platform.',
      },
    },
  ],
};

const features = [
  {
    title: 'QR menu and ordering',
    body: 'Guests scan the table code, browse your menu, and send orders from their phone. No app, no sign-up.',
    icon: 'M5 7h14M5 12h14M5 17h7',
  },
  {
    title: 'Clear kitchen view',
    body: 'See active tabs and their orders by table in real time. Every item and tab status always visible to your team.',
    icon: 'M5 12h4l3 7 3-14 2 7h3',
  },
  {
    title: 'Table tabs, zero chaos',
    body: 'Group orders into tabs by table or by guest. View the balance, apply discounts, and mark as paid in one click.',
    icon: 'M5 10a7 7 0 0114 0v3a4 4 0 01-4 4H9a4 4 0 01-4-4v-3zM9 17v1a3 3 0 006 0v-1',
  },
  {
    title: 'Multi-location',
    body: 'Manage multiple venues under a single account, each with its own menu, team, and reporting.',
    icon: 'M5 9h14v10H5zM3 5h18',
  },
  {
    title: 'Real-time updates',
    body: 'Orders and tabs update automatically. Staff always see the latest list — no refreshing, no missed tickets.',
    icon: 'M4 12a8 8 0 0114.32-4.906L21 5M20 12a8 8 0 01-14.32 4.906L3 19',
  },
  {
    title: 'Localized for your country',
    body: 'Configure language, currency, and taxes for your region so totals are always right.',
    icon: 'M7 7h10M7 12h6M7 17h4',
  },
];
---

<BaseLayout
  lang="en"
  title="Cheflink - QR Ordering for Restaurants and Bars"
  description="Cheflink connects QR orders, kitchen, and table tabs in a single real-time dashboard."
  canonicalPath="/en/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="min-h-screen bg-cream">
    <Navbar lang="en" currentPage="index" />

    <main>
      <!-- HERO -->
      <section id="hero" class="relative overflow-hidden">
        <div class="mx-auto flex max-w-7xl flex-col gap-14 px-4 pb-16 pt-12 sm:px-6 lg:flex-row lg:items-center lg:gap-16 lg:px-8 lg:pb-28 lg:pt-20">
          <div class="max-w-xl lg:max-w-lg">
            <h1 class="font-display text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]">
              Your menu can <span class="text-brand-700">sell more</span> without a word.
            </h1>
            <p class="mt-6 text-lg leading-8 text-sand-600">
              Cheflink connects QR orders, kitchen, and table tabs in one real-time dashboard — less running around for staff, more spending per table, and guests who never have to flag down a waiter to order or pay.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a
                id="signup"
                href="https://app.cheflink.io/signup/"
                class="inline-flex items-center justify-center rounded-full bg-brand-700 px-6 py-3 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-brand-800"
              >
                Try it free
              </a>
              <a
                href="/en/contact/"
                class="inline-flex items-center justify-center rounded-full border border-sand-300 bg-white px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-sand-50"
              >
                Book a demo
              </a>
            </div>

            <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm text-sand-600">
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-brand-600" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10.5 8.5 14 15 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>No app required for guests</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-brand-600" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10.5 8.5 14 15 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Works with your current workflow</span>
              </div>
            </div>

            <dl class="mt-10 grid max-w-md grid-cols-3 gap-6 border-t border-sand-200 pt-6">
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">+30%</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">faster service during peak hours</dd>
              </div>
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">2×</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">more orders when the venue fills up</dd>
              </div>
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">24/7</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">chat and email support</dd>
              </div>
            </dl>
          </div>

          <div class="relative flex-1">
            <!-- structural warm panel, not a blurry blob -->
            <div class="absolute -right-6 -top-6 bottom-10 left-10 -z-10 rounded-[2.2rem] bg-gradient-to-br from-brand-100 via-sand-100 to-brand-50" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-lg overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-lift">
              <img src="/assets/img/screenshots/kds.png" alt="Cheflink Kitchen Display System" class="block w-full" loading="eager" width="1920" height="1200" />
            </div>
            <div class="absolute -bottom-6 -right-2 w-[104px] overflow-hidden rounded-[1.7rem] border-[5px] border-ink bg-ink shadow-lift ring-1 ring-white/60 sm:w-[124px] sm:right-0 lg:-right-6">
              <div class="absolute left-1/2 top-0 z-10 h-[12px] w-[42px] -translate-x-1/2 rounded-b-lg bg-ink"></div>
              <img src="/assets/img/screenshots/consumer_menu.png" alt="Guest menu view in Cheflink" class="block w-full" loading="eager" width="1449" height="2961" />
            </div>
          </div>
        </div>
      </section>

      <!-- TRUST STRIP -->
      <section class="border-y border-sand-200 bg-white">
        <div class="mx-auto grid max-w-7xl gap-6 px-4 py-8 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
          {[
            ['No new hardware', 'Runs on the phones and screens you already have.'],
            ['Works alongside your POS', 'Add QR ordering without ripping anything out.'],
            ['Live in a day', 'Build your menu, print the codes, start taking orders.'],
            ['Built for service', 'Designed around how busy floors actually run.'],
          ].map(([title, body]) => (
            <div class="flex flex-col gap-1">
              <span class="text-sm font-semibold text-ink">{title}</span>
              <span class="text-sm leading-6 text-sand-600">{body}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- FEATURES -->
      <section id="features" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">Features</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Everything you need in one place</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">
            Cheflink covers the full flow: guests scan a QR, send their orders, and your team sees every ticket and table tab in real time.
          </p>
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <div class="group rounded-2xl border border-sand-200 bg-white p-6 shadow-soft transition-shadow hover:shadow-lift">
              <div class="inline-flex rounded-xl bg-brand-50 p-2.5 ring-1 ring-brand-100">
                <svg class="h-5 w-5 text-brand-700" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={f.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </div>
              <h3 class="mt-4 text-base font-semibold text-ink">{f.title}</h3>
              <p class="mt-2 text-sm leading-6 text-sand-600">{f.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- HOW IT WORKS -->
      <section id="how-it-works" class="border-y border-sand-200 bg-sand-50">
        <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
          <div class="max-w-2xl">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">How it works</span>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">From scan to payment in three steps</h2>
          </div>

          <div class="relative mt-14 grid gap-10 md:grid-cols-3">
            <div class="absolute left-0 right-0 top-7 hidden h-px bg-sand-300 md:block" aria-hidden="true"></div>
            {[
              ['Guests scan the table code', "Each table has a unique QR that opens your menu in the guest's browser. No downloads, no friction."],
              ['Orders arrive in Cheflink', 'Kitchen and servers see every order in real time, with a visual highlight for new tickets.'],
              ['Close the tab and collect payment', 'Apply discounts, service charges, and mark the tab as paid. Cheflink saves the history for every table.'],
            ].map(([title, body], i) => (
              <div class="relative">
                <div class="relative z-10 flex h-14 w-14 items-center justify-center rounded-full bg-brand-700 font-display text-xl font-semibold text-white shadow-soft ring-4 ring-sand-50">{i + 1}</div>
                <h3 class="mt-5 text-base font-semibold text-ink">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-sand-600">{body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- SCREENSHOTS -->
      <section id="screenshots" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">The dashboard</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">See Cheflink in action</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">A real look at what you and your team see every day.</p>
        </div>

        <div class="mb-6 mt-10 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Dashboard views">
          <button type="button" role="tab" aria-selected="true" aria-controls="tab-panel-1" data-tab="1" class="screenshot-tab rounded-full border border-brand-700 bg-brand-700 px-4 py-1.5 text-sm font-medium text-white transition-colors">Sales Stats</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-2" data-tab="2" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Trends</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-3" data-tab="3" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Sales Detail</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-4" data-tab="4" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Backoffice Menu</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-5" data-tab="5" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Kitchen Display System</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-6" data-tab="6" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Inventory</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-7" data-tab="7" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Floor View</button>
        </div>

        <div class="relative overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-lift">
          <div class="flex items-center justify-center border-b border-sand-100 bg-sand-50 px-4 py-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-xs text-sand-500 ring-1 ring-sand-200">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.7" /><path d="M8 11V8a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
              app.cheflink.io
            </span>
          </div>
          <div id="tab-panel-1" role="tabpanel"><img src="/assets/img/screenshots/sales1.png" alt="Cheflink dashboard overview" class="w-full" loading="eager" width="1920" height="1200" /></div>
          <div id="tab-panel-2" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/sales2.png" alt="Cheflink sales trends" class="w-full" loading="lazy" width="1920" height="1200" /></div>
          <div id="tab-panel-3" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/sales3.png" alt="Cheflink sales detail" class="w-full" loading="lazy" width="1920" height="1200" /></div>
          <div id="tab-panel-4" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/backoffice_menu.png" alt="Cheflink backoffice menu" class="w-full" loading="lazy" width="1920" height="1200" /></div>
          <div id="tab-panel-5" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/kds.png" alt="Cheflink Kitchen Display System" class="w-full" loading="lazy" width="1920" height="1200" /></div>
          <div id="tab-panel-6" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/inventory.png" alt="Cheflink inventory management" class="w-full" loading="lazy" width="1920" height="994" /></div>
          <div id="tab-panel-7" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/floor_view.png" alt="Cheflink floor view" class="w-full" loading="lazy" width="1920" height="994" /></div>
        </div>
      </section>

      <!-- CONSUMER EXPERIENCE -->
      <section id="consumer-view" class="border-y border-sand-200 bg-sand-50">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
          <div class="mx-auto max-w-2xl text-center">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">The guest experience</span>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">What your guests see</h2>
            <p class="mt-4 text-lg leading-8 text-sand-600">
              No downloads, no accounts. They scan the table QR and within seconds they're browsing your menu, placing their order, and tracking its status — all from their phone's browser.
            </p>
          </div>

          <div
            class="mt-14 flex flex-col items-center gap-6"
            id="phone-carousel"
            data-labels='["Menu","Add to Cart","Your Cart","Order Status","Tab Paid"]'
          >
            <div class="flex items-center gap-6 sm:gap-10">
              <button type="button" id="carousel-prev" aria-label="Previous" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-sand-200 bg-white text-sand-500 shadow-soft transition hover:border-sand-300 hover:text-ink">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="relative w-[260px] overflow-hidden rounded-[2.8rem] border-[8px] border-ink bg-ink shadow-lift sm:w-[300px]">
                <div class="absolute left-1/2 top-0 z-10 h-[20px] w-[88px] -translate-x-1/2 rounded-b-xl bg-ink"></div>
                <div id="carousel-track" class="flex transition-transform duration-300 ease-in-out">
                  <img src="/assets/img/screenshots/consumer_menu.png"  alt="Restaurant menu in Cheflink"       class="block w-full shrink-0" loading="eager" width="1449" height="2961" />
                  <img src="/assets/img/screenshots/add_item.png"       alt="Adding item to order in Cheflink"  class="block w-full shrink-0" loading="lazy"  width="1449" height="2961" />
                  <img src="/assets/img/screenshots/cart.png"           alt="Order cart in Cheflink"            class="block w-full shrink-0" loading="lazy"  width="1449" height="2961" />
                  <img src="/assets/img/screenshots/order_progress.png" alt="Order progress in Cheflink"        class="block w-full shrink-0" loading="lazy"  width="1449" height="2961" />
                  <img src="/assets/img/screenshots/tab_paid.png"       alt="Tab paid in Cheflink"              class="block w-full shrink-0" loading="lazy"  width="1449" height="2961" />
                </div>
              </div>
              <button type="button" id="carousel-next" aria-label="Next" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-sand-200 bg-white text-sand-500 shadow-soft transition hover:border-sand-300 hover:text-ink">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <p id="carousel-label" class="text-sm font-medium text-ink"></p>
            <div class="flex gap-2" id="carousel-dots" role="tablist" aria-label="Guest screens"></div>
          </div>
        </div>
      </section>

      <!-- PRICING -->
      <section id="pricing" class="hidden mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">Pricing</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Pricing that grows with you</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">Start free and upgrade whenever you're ready to use Cheflink across all your tables and locations.</p>
        </div>

        <div class="mt-12 grid items-start gap-6 md:grid-cols-3">
          <!-- STARTER -->
          <div class="flex flex-col justify-between rounded-3xl border border-sand-200 bg-white p-7 shadow-soft">
            <div>
              <h3 class="font-display text-lg font-semibold text-ink">Starter</h3>
              <p class="mt-1 text-sm text-sand-600">Perfect for trying out Cheflink.</p>
              <div class="mt-5 flex items-baseline gap-1">
                <span class="font-display text-4xl font-semibold text-ink">$0</span>
                <span class="text-sm text-sand-500">/ month</span>
              </div>
              <ul class="mt-6 space-y-2.5 text-sm text-sand-700">
                {['1 venue with 1 table','1 user','10 menu items','5 orders per day','Kitchen Display System (KDS)'].map(item => (
                  <li class="flex items-start gap-2.5">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-600"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a href="https://app.cheflink.io/signup/" class="mt-7 inline-flex items-center justify-center rounded-full border border-sand-300 bg-white px-4 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-sand-50">Try it free</a>
          </div>

          <!-- PREMIUM -->
          <div class="relative flex flex-col justify-between rounded-3xl border-2 border-brand-300 bg-white p-7 shadow-lift md:-mt-3 md:mb-3">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-700 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-white shadow-soft">Most popular</div>
            <div>
              <h3 class="font-display text-lg font-semibold text-ink">Premium</h3>
              <p class="mt-1 text-sm text-sand-600">Ideal for small and medium businesses.</p>
              <div class="mt-5 flex items-baseline gap-1">
                <span class="font-display text-4xl font-semibold text-ink">$99</span>
                <span class="text-sm text-sand-500">/ month</span>
              </div>
              <ul class="mt-6 space-y-2.5 text-sm text-sand-700">
                {['1 venue with unlimited tables','Unlimited users','Unlimited menu items','Unlimited orders','Kitchen Display System (KDS)','Invoicing','Shift closing','Sales dashboard','Reports','Priority support'].map(item => (
                  <li class="flex items-start gap-2.5">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-600"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a href="/en/contact/?plan=Premium" class="mt-7 inline-flex items-center justify-center rounded-full bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-brand-800">Contact us</a>
          </div>

          <!-- DIAMOND -->
