---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Cheflink',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'QR ordering and table management system for restaurants and bars. Connects QR orders, kitchen display, and table tabs in a single real-time dashboard.',
  url: 'https://cheflink.io/en/',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter',
      price: '0',
      priceCurrency: 'USD',
      description: '1 venue, 1 table, 1 user, 10 menu items, 5 orders per day',
    },
    {
      '@type': 'Offer',
      name: 'Premium',
      price: '99',
      priceCurrency: 'USD',
      description: '1 venue with unlimited tables, unlimited users, unlimited orders, KDS, invoicing, sales dashboard',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does the guest need to download an app?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. They simply scan the QR code at the table and Cheflink opens in the browser. They can view the menu, place orders, and link everything to their table tab.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use Cheflink across multiple locations?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. With the Diamond plan you can use it across unlimited venues with unlimited tables.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does Cheflink replace my POS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can use Cheflink alongside your current point-of-sale system, or integrate it with a digital payment provider to collect payment directly through the platform.',
      },
    },
  ],
};

const features = [
  {
    title: 'Staff management',
    body: 'Add your team with roles and permissions. Control who can take orders, edit menus, or close out tabs.',
    icon: 'M9 10a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM4 18a5 5 0 0110 0M16 10a2.5 2.5 0 10-1-4.85M20 18a5 5 0 00-3.2-4.66',
  },
  {
    title: 'Inventory management',
    body: 'Track stock in real time, get low-stock alerts, and keep your menu in sync with what is actually available.',
    icon: 'M12 3l8 4v10l-8 4-8-4V7zM4 7l8 4 8-4M12 11v10',
  },
  {
    title: 'Loyalty program',
    body: 'Reward repeat guests with points and perks that bring them back — tracked automatically on every visit.',
    icon: 'M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L12 16.77l-5.2 2.73.99-5.79-4.21-4.1 5.82-.85z',
  },
  {
    title: 'Invoicing',
    body: 'Generate invoices and receipts with your taxes and service charges already applied, ready to send or print.',
    icon: 'M14 3H7a1 1 0 00-1 1v16a1 1 0 001 1h10a1 1 0 001-1V7zM14 3v4h4M9 12h6M9 16h4',
  },
  {
    title: 'Table reservations',
    body: 'Let guests book a table online and manage your floor with a clear view of every upcoming reservation.',
    icon: 'M5 6h14a1 1 0 011 1v12a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1zM4 10h16M8 3v4M16 3v4',
  },
  {
    title: 'Digital payments',
    body: 'Let guests pay from their phone or charge them right from the tab with an integrated payment provider.',
    icon: 'M3 6h18a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V7a1 1 0 011-1zM2 10h20M6 15h4',
  },
  {
    title: 'Reports',
    body: 'See sales, top items, busiest hours, and table performance in clear dashboards that guide your decisions.',
    icon: 'M4 20h16M7 20v-6M12 20V8M17 20v-9',
  },
];

// Live demo venue table — every scan opens its own isolated tab (see the demo block in #screenshots).
const demoMenuUrl = 'https://app.cheflink.io/t/757_iu-h/';
---

<BaseLayout
  lang="en"
  title="Cheflink - QR Ordering for Restaurants and Bars"
  description="Cheflink connects QR orders, kitchen, and table tabs in a single real-time dashboard."
  canonicalPath="/en/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="min-h-screen bg-cream">
    <Navbar lang="en" currentPage="index" />

    <main>
      <!-- HERO -->
      <section id="hero" class="relative overflow-hidden">
        <div class="mx-auto flex max-w-7xl flex-col gap-14 px-4 pb-16 pt-12 sm:px-6 lg:flex-row lg:items-center lg:gap-16 lg:px-8 lg:pb-28 lg:pt-20">
          <div class="max-w-xl lg:max-w-lg">
            <h1 class="font-display text-4xl font-semibold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]">
              Your menu can <span class="text-brand-700">sell more</span> without a word.
            </h1>
            <p class="mt-6 text-lg leading-8 text-sand-600">
              Cheflink connects QR orders, kitchen, and table tabs in one real-time dashboard — less running around for staff, more spending per table, and guests who never have to flag down a waiter to order or pay.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a
                id="signup"
                href="https://app.cheflink.io/signup/"
                class="inline-flex items-center justify-center rounded-full bg-brand-700 px-6 py-3 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-brand-800"
              >
                Try it free
              </a>
              <a
                href="/en/contact/"
                class="inline-flex items-center justify-center rounded-full border border-sand-300 bg-white px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-sand-50"
              >
                Book a demo
              </a>
            </div>

            <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm text-sand-600">
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-brand-600" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10.5 8.5 14 15 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>No app required</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="h-4 w-4 text-brand-600" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 10.5 8.5 14 15 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Works with your current workflow</span>
              </div>
            </div>

            <dl class="mt-10 grid max-w-md grid-cols-3 gap-6 border-t border-sand-200 pt-6">
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">+30%</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">faster service during peak hours</dd>
              </div>
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">2×</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">more orders when the venue fills up</dd>
              </div>
              <div>
                <dt class="font-display text-2xl font-semibold text-ink">24/7</dt>
                <dd class="mt-1 text-xs leading-5 text-sand-500">chat and email support</dd>
              </div>
            </dl>
          </div>

          <div class="relative flex-1">
            <!-- structural warm panel, not a blurry blob -->
            <div class="absolute -right-6 -top-6 bottom-10 left-10 -z-10 rounded-[2.2rem] bg-gradient-to-br from-brand-100 via-sand-100 to-brand-50" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-lg overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-lift">
              <img src="/assets/img/screenshots/01-kds-board.png" alt="Cheflink Kitchen Display System" class="block w-full" loading="eager" width="2880" height="1800" />
            </div>
            <div class="absolute -bottom-6 -right-2 w-[104px] overflow-hidden rounded-[1.7rem] border-[5px] border-ink bg-ink shadow-lift ring-1 ring-white/60 sm:w-[124px] sm:right-0 lg:-right-6">
              <div class="absolute left-1/2 top-0 z-10 h-[12px] w-[42px] -translate-x-1/2 rounded-b-lg bg-ink"></div>
              <img src="/assets/img/screenshots/06-consumer-menu.png" alt="Guest menu view in Cheflink" class="block w-full" loading="eager" width="1170" height="2532" />
            </div>
          </div>
        </div>
      </section>

      <!-- TRUST STRIP -->
      <section class="border-y border-sand-200 bg-white">
        <div class="mx-auto grid max-w-7xl gap-6 px-4 py-8 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
          {[
            ['No new hardware', 'Runs on the phones and screens you already have.'],
            ['Works alongside your POS', 'Add QR ordering without ripping anything out.'],
            ['Live in a day', 'Build your menu, print the codes, start taking orders.'],
            ['Built for service', 'Designed around how busy floors actually run.'],
          ].map(([title, body]) => (
            <div class="flex flex-col gap-1">
              <span class="text-sm font-semibold text-ink">{title}</span>
              <span class="text-sm leading-6 text-sand-600">{body}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- FEATURES -->
      <section id="features" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">Features</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Everything you need in one place</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">
            Cheflink is more than QR ordering. Run your whole front and back of house — from reservations and payments to staff, stock, and reporting — without juggling separate tools.
          </p>
        </div>

        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <div class="rounded-2xl border border-sand-200 bg-gradient-to-b from-white to-sand-50/60 p-7 shadow-soft transition-shadow hover:shadow-lift">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-[0_8px_20px_-8px_rgba(249,114,22,0.55)] ring-1 ring-inset ring-white/20">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={f.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </div>
              <h3 class="mt-5 text-base font-semibold text-ink">{f.title}</h3>
              <p class="mt-2 text-sm leading-6 text-sand-600">{f.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- HOW IT WORKS -->
      <section id="how-it-works" class="border-y border-sand-200 bg-sand-50">
        <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
          <div class="max-w-2xl">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">How it works</span>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">From scan to payment in three steps</h2>
          </div>

          <div class="relative mt-14 grid gap-6 md:grid-cols-3">
            <!-- Flow connector (desktop) -->
            <div class="absolute left-[16.6%] right-[16.6%] top-[88px] hidden border-t-2 border-dashed border-sand-300 md:block" aria-hidden="true"></div>

            <!-- STEP 1 — Scan the QR -->
            <article class="group relative z-10 flex flex-col rounded-2xl border border-sand-200 bg-white p-5 shadow-soft transition-shadow hover:shadow-lift">
              <div class="relative mb-5 flex h-44 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-sand-50 to-brand-50 ring-1 ring-sand-100">
                <span class="absolute right-3 top-3 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 font-display text-sm font-semibold text-white shadow-soft">1</span>
                <div class="relative">
                  <img src="/assets/img/landing_qr.png" alt="Cheflink table QR code" width="112" height="112" class="h-28 w-28 rounded-lg bg-white p-1.5 shadow-soft" loading="lazy" />
                  <span class="pointer-events-none absolute -inset-2.5" aria-hidden="true">
                    <span class="absolute left-0 top-0 h-5 w-5 rounded-tl-md border-l-2 border-t-2 border-brand-500"></span>
                    <span class="absolute right-0 top-0 h-5 w-5 rounded-tr-md border-r-2 border-t-2 border-brand-500"></span>
                    <span class="absolute bottom-0 left-0 h-5 w-5 rounded-bl-md border-b-2 border-l-2 border-brand-500"></span>
                    <span class="absolute bottom-0 right-0 h-5 w-5 rounded-br-md border-b-2 border-r-2 border-brand-500"></span>
                    <span class="absolute inset-x-0 top-1/2 h-0.5 animate-pulse bg-brand-500/70"></span>
                  </span>
                </div>
              </div>
              <h3 class="text-base font-semibold text-ink">Guests scan the table code</h3>
              <p class="mt-2 text-sm leading-6 text-sand-600">Each table has a unique QR that opens your menu in the guest's browser. No downloads, no friction.</p>
            </article>

            <!-- STEP 2 — Orders arrive in the kitchen -->
            <article class="group relative z-10 flex flex-col rounded-2xl border border-sand-200 bg-white p-5 shadow-soft transition-shadow hover:shadow-lift">
              <div class="relative mb-5 flex h-44 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-sand-50 to-brand-50 ring-1 ring-sand-100">
                <span class="absolute right-3 top-3 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 font-display text-sm font-semibold text-white shadow-soft">2</span>
                <div class="w-44 -rotate-3 rounded-lg bg-white p-3 text-left shadow-lift ring-1 ring-sand-200">
                  <div class="flex items-center justify-between border-b border-dashed border-sand-200 pb-1.5">
                    <span class="font-display text-xs font-semibold text-ink">Table 7</span>
                    <span class="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wide text-emerald-600">
                      <span class="relative flex h-1.5 w-1.5">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
                        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      </span>
                      New
                    </span>
                  </div>
                  <ul class="mt-2 space-y-1 text-xs text-sand-600">
                    <li>2× Smash Burger</li>
                    <li>1× Truffle Fries</li>
                    <li>1× Lemonade</li>
                  </ul>
                </div>
              </div>
              <h3 class="text-base font-semibold text-ink">Orders arrive in the kitchen</h3>
              <p class="mt-2 text-sm leading-6 text-sand-600">Kitchen and servers see every order in real time, with a visual highlight for new tickets.</p>
            </article>

            <!-- STEP 3 — Close the tab and collect payment -->
            <article class="group relative z-10 flex flex-col rounded-2xl border border-sand-200 bg-white p-5 shadow-soft transition-shadow hover:shadow-lift">
              <div class="relative mb-5 flex h-44 items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-sand-50 to-brand-50 ring-1 ring-sand-100">
                <span class="absolute right-3 top-3 z-10 flex h-7 w-7 items-center justify-center rounded-full bg-brand-700 font-display text-sm font-semibold text-white shadow-soft">3</span>
                <div class="relative w-44 rotate-2 rounded-lg bg-white p-3 text-left shadow-lift ring-1 ring-sand-200">
                  <div class="flex items-center justify-between">
                    <span class="font-display text-xs font-semibold text-ink">Table 7</span>
                    <span class="text-[10px] text-sand-400">#1042</span>
                  </div>
                  <ul class="mt-2 space-y-1 text-xs text-sand-600">
                    <li class="flex justify-between"><span>Smash Burger ×2</span><span>$24.00</span></li>
                    <li class="flex justify-between"><span>Truffle Fries</span><span>$9.00</span></li>
                    <li class="flex justify-between"><span>Service 10%</span><span>$3.30</span></li>
                  </ul>
                  <div class="mt-2 flex justify-between border-t border-sand-200 pt-1.5 text-xs font-semibold text-ink">
                    <span>Total</span><span>$36.30</span>
                  </div>
                  <span class="absolute -right-2.5 top-7 rotate-12 rounded-md border-2 border-emerald-500/80 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-emerald-600">Paid</span>
                </div>
              </div>
              <h3 class="text-base font-semibold text-ink">Close the tab and collect payment</h3>
              <p class="mt-2 text-sm leading-6 text-sand-600">Apply discounts, service charges, and mark the tab as paid. Cheflink saves the history for every table.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- SCREENSHOTS -->
      <section id="screenshots" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">The dashboard</span>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">See Cheflink in action</h2>
          <p class="mt-4 text-lg leading-8 text-sand-600">A real look at what you and your team see every day.</p>
        </div>

                <div class="mb-6 mt-10 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Dashboard views">
          <button type="button" role="tab" aria-selected="true" aria-controls="tab-panel-1" data-tab="1" class="screenshot-tab rounded-full border border-brand-700 bg-brand-700 px-4 py-1.5 text-sm font-medium text-white transition-colors">Sales Stats</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-2" data-tab="2" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Backoffice Menu</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-3" data-tab="3" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Kitchen Display System</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-4" data-tab="4" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Inventory</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="tab-panel-5" data-tab="5" class="screenshot-tab rounded-full border border-sand-200 bg-white px-4 py-1.5 text-sm font-medium text-sand-600 transition-colors hover:border-sand-300 hover:text-ink">Floor View</button>
        </div>

        <div class="relative overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-lift">
          <div class="flex items-center justify-center border-b border-sand-100 bg-sand-50 px-4 py-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-xs text-sand-500 ring-1 ring-sand-200">
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" stroke="currentColor" stroke-width="1.7" /><path d="M8 11V8a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
              app.cheflink.io
            </span>
          </div>
          <div id="tab-panel-1" role="tabpanel"><img src="/assets/img/screenshots/03-sales-kpis.png" alt="Cheflink sales stats" class="w-full" loading="eager" width="2880" height="3280" /></div>
          <div id="tab-panel-2" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/04-backoffice-menu.png" alt="Cheflink backoffice menu" class="w-full" loading="lazy" width="2880" height="1800" /></div>
          <div id="tab-panel-3" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/01-kds-board.png" alt="Cheflink Kitchen Display System" class="w-full" loading="lazy" width="2880" height="1800" /></div>
          <div id="tab-panel-4" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/05-backoffice-inventory.png" alt="Cheflink inventory management" class="w-full" loading="lazy" width="2880" height="1800" /></div>
          <div id="tab-panel-5" role="tabpanel" class="hidden"><img src="/assets/img/screenshots/02-kds-floor.png" alt="Cheflink floor view" class="w-full" loading="lazy" width="2880" height="1800" /></div>
        </div>
      </section>

      <!-- CONSUMER EXPERIENCE -->
      <section id="consumer-view" class="border-y border-sand-200 bg-sand-50">
        <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
          <div class="mx-auto max-w-2xl text-center">
            <span class="text-xs font-semibold uppercase tracking-wider text-brand-700">The guest experience</span>
            <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">What your guests see</h2>
            <p class="mt-4 text-lg leading-8 text-sand-600">
              No downloads, no accounts. They scan the table QR and within seconds they're browsing your menu, placing their order, and tracking its status — all from their phone's browser.
            </p>
          </div>

          <div
            class="mt-14 flex flex-col items-center gap-6"
            id="phone-carousel"
            data-labels='["Menu", "Add to Cart", "Order Status", "Tab Paid", "Reservations"]'
          >
            <div class="flex items-center gap-6 sm:gap-10">
              <button type="button" id="carousel-prev" aria-label="Previous" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-sand-200 bg-white text-sand-500 shadow-soft transition hover:border-sand-300 hover:text-ink">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="relative w-[260px] overflow-hidden rounded-[2.8rem] border-[8px] border-ink bg-ink shadow-lift sm:w-[300px]">
                <div class="absolute left-1/2 top-0 z-10 h-[20px] w-[88px] -translate-x-1/2 rounded-b-xl bg-ink"></div>
                <div id="carousel-track" class="flex transition-transform duration-300 ease-in-out">
                  <img src="/assets/img/screenshots/06-consumer-menu.png" alt="Restaurant menu in Cheflink" class="block w-full shrink-0" loading="eager" width="1170" height="2532" />
                  <img src="/assets/img/screenshots/07-consumer-add-item.png" alt="Adding item to order in Cheflink" class="block w-full shrink-0" loading="lazy" width="1170" height="2532" />
                  <img src="/assets/img/screenshots/08-consumer-tab.png" alt="Order progress in Cheflink" class="block w-full shrink-0" loading="lazy" width="1170" height="2532" />
                  <img src="/assets/img/screenshots/09-consumer-paid-tab.png" alt="Tab paid in Cheflink" class="block w-full shrink-0" loading="lazy" width="1170" height="2532" />
                  <img src="/assets/img/screenshots/10-table-reservation.png" alt="Booking a reservation in Cheflink" class="block w-full shrink-0" loading="lazy" width="1170" height="2730" />
                </div>
              </div>
