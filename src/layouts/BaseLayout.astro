---
import { APP_NAME } from '../config/site';
interface Props {
  lang: 'es' | 'en';
  title: string;
  description: string;
  canonicalPath: string; // e.g. '/es/' or '/en/contact/'
  ogImage?: string; // absolute URL, defaults to KDS screenshot
}

const { lang, title, description, canonicalPath, ogImage } = Astro.props;

const site = 'https://cheflink.io';
const otherLang = lang === 'es' ? 'en' : 'es';
const canonicalUrl = `${site}${canonicalPath}`;
// Social card per language, rendered by scripts/make-og.sh (1200×630 JPEG)
const ogImageUrl = ogImage ?? `${site}/assets/img/og-${lang}.jpg`;
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: APP_NAME,
  url: site,
  logo: `${site}/assets/img/logo.png`,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    availableLanguage: ['English', 'Spanish'],
  },
};
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />

  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="es" href={`${site}${canonicalPath.replace(`/${lang}/`, '/es/')}`} />
  <link rel="alternate" hreflang="en" href={`${site}${canonicalPath.replace(`/${lang}/`, '/en/')}`} />
  <link rel="alternate" hreflang="x-default" href={`${site}/`} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:site_name" content={APP_NAME} />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- Organization structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <slot name="head" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..700,0..100,0..1;1,9..144,300..700,0..100,0..1&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Kalam:wght@400;700&display=swap" rel="stylesheet" />

  <style is:global>
    html, body {
      font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    /* Fraunces with its optical-size, softness and "wonk" axes: roman headings stay
       crisp, italics get the soft, slightly quirky cut. */
    .font-display {
      font-family: "Fraunces", ui-serif, Georgia, serif;
      font-optical-sizing: auto;
      font-variation-settings: "SOFT" 40, "WONK" 0;
    }
    .font-display em, .font-display i, .display-italic {
      font-style: italic;
      font-variation-settings: "SOFT" 60, "WONK" 1;
    }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

    /* Torn edges of a kitchen ticket (paper color = #FFFDF8) */
    .serrated-b { height: 6px; background: conic-gradient(from -45deg at 50% 100%, #FFFDF8 90deg, transparent 0) 0 0 / 12px 6px repeat-x; }
    .serrated-t { height: 6px; background: conic-gradient(from 135deg at 50% 0, #FFFDF8 90deg, transparent 0) 0 0 / 12px 6px repeat-x; }

    /* Gingham tablecloth behind the demo placemat */
    .gingham {
      background-color: #FBF8F4;
      background-image: linear-gradient(90deg, rgba(249, 114, 22, 0.13) 50%, transparent 50%), linear-gradient(rgba(249, 114, 22, 0.13) 50%, transparent 50%);
      background-size: 64px 64px;
    }

    .no-scrollbar { scrollbar-width: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
  </style>

  <script defer src="https://cloud.umami.is/script.js" data-website-id="a841e4bb-6b9b-46d9-8e33-9de2785de277"></script>
</head>
<body class="bg-cream text-ink">
  <slot />
  <script>
    document.querySelectorAll('[data-year]').forEach(el => {
      el.textContent = String(new Date().getFullYear());
    });
    const toggleBtn = document.querySelector('[data-mobile-toggle]');
    const menu = document.querySelector('[data-mobile-menu]');
    if (toggleBtn && menu) {
      toggleBtn.addEventListener('click', () => menu.classList.toggle('hidden'));
    }
  </script>
</body>
</html>
