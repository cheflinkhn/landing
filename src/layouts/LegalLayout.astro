---
import BaseLayout from './BaseLayout.astro';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description: string;
  canonicalPath: string;
}

const { lang, title, description, canonicalPath } = Astro.props;

const t = {
  es: { tagline: 'Pedidos por QR y cuentas por mesa', back: 'Volver al inicio' },
  en: { tagline: 'QR Orders and Table Tabs', back: 'Back to home' },
}[lang];

const homePath = `/${lang}/`;
---

<BaseLayout {lang} {title} {description} {canonicalPath}>
  <div class="min-h-screen bg-cream">
    <header class="border-b border-sand-200 bg-cream/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
        <a href={homePath} class="flex items-center gap-2.5">
          <img src="/assets/img/logo.png" alt="Cheflink Logo" class="h-9 w-9 rounded-lg ring-1 ring-sand-200" />
          <span class="font-display text-lg font-semibold tracking-tight text-ink">Cheflink</span>
        </a>
        <a href={homePath} class="text-sm font-medium text-sand-600 transition-colors hover:text-ink">{t.back}</a>
      </div>
    </header>

    <slot />

    <footer class="border-t border-sand-200 bg-sand-50">
      <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-6 text-xs text-sand-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <span>© <span data-year></span> Cheflink.</span>
        <div class="flex flex-wrap gap-4">
          <a href={homePath} class="transition-colors hover:text-ink">{lang === 'es' ? 'Inicio' : 'Home'}</a>
          <a href={`/${lang}/terms/`} class="transition-colors hover:text-ink">{lang === 'es' ? 'Términos y Condiciones' : 'Terms & Conditions'}</a>
          <a href={`/${lang}/privacy/`} class="transition-colors hover:text-ink">{lang === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
