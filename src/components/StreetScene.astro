---
// The street along the hero's floor: a hand-drawn row of food businesses in
// service (brunch spot, café, taquería, bistro, bar, lounge, pizzeria, sushi
// bar) with their terraces on the pavement. The drawing is generated by
// scripts/street-scene/build.mjs into src/assets/street-scene.svg and inlined
// here; it is static and ends in the road, which dissolves into the ground of
// the section below.
//
// The drawing is a block far wider than any screen and behaves like a cover
// image (preserveAspectRatio "slice"): it takes its scale from the height set
// here, stays centred on the eight main venues, and is cropped evenly on both
// sides, so it runs edge to edge on every screen and the phone still sees the
// middle of the block at a readable size.
import scene from '../assets/street-scene.svg?raw';
interface Props { lang: 'es' | 'en' }
const { lang } = Astro.props;
const label = lang === 'es'
  ? 'Una calle de restaurantes, cafés y bares, dibujada a mano'
  : 'A street of restaurants, cafés and bars, drawn by hand';
---

<div class="overflow-hidden [&>svg]:block [&>svg]:w-full [&>svg]:h-[190px] sm:[&>svg]:h-[240px] lg:[&>svg]:h-[300px]" role="img" aria-label={label}>
  <Fragment set:html={scene} />
</div>
