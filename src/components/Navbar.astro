---
interface Props {
  lang: 'es' | 'en';
  currentPage?: 'index' | 'contact' | 'privacy' | 'terms';
}

const { lang, currentPage = 'index' } = Astro.props;

const t = {
  es: {
    tagline: 'Pedidos por QR · Cuentas por mesa',
    features: 'Características',
    howItWorks: 'Cómo funciona',
    pricing: 'Precios',
    faq: 'Preguntas frecuentes',
    demo: 'Agendar Demo',
    login: 'Log In',
    openNav: 'Abrir navegación',
  },
  en: {
    tagline: 'QR Orders · Table Tabs',
    features: 'Features',
    howItWorks: 'How it works',
    pricing: 'Pricing',
    faq: 'FAQ',
    demo: 'Book a Demo',
    login: 'Log In',
    openNav: 'Open navigation',
  },
}[lang];

const pageSlug: Record<string, string> = {
  index: '',
  contact: 'contact/',
  privacy: 'privacy/',
  terms: 'terms/',
};

const contactHref = `/${lang}/contact/`;
const homePath = `/${lang}/`;
const esHref = `/es/${pageSlug[currentPage]}`;
const enHref = `/en/${pageSlug[currentPage]}`;
---

<header class="border-b border-slate-200 bg-white/80 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-3">
      <div class="flex items-center justify-center">
        <a href={homePath}><img src="/assets/img/logo.png" alt="Cheflink Logo" class="h-9 w-9 rounded" /></a>
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-semibold tracking-tight sm:text-base">Cheflink</span>
        <span class="hidden text-xs text-slate-500 sm:block">{t.tagline}</span>
      </div>
    </div>

    <div class="hidden items-center gap-8 text-sm text-slate-600 md:flex">
      <a href={`${homePath}#features`} class="hover:text-slate-900">{t.features}</a>
      <a href={`${homePath}#how-it-works`} class="hover:text-slate-900">{t.howItWorks}</a>
      <a href={`${homePath}#pricing`} class="hover:text-slate-900">{t.pricing}</a>
      <a href={`${homePath}#faq`} class="hover:text-slate-900">{t.faq}</a>
    </div>

    <div class="hidden items-center gap-4 md:flex">
      <!-- Language dropdown -->
      <div class="relative" data-lang-dropdown>
        <button
          type="button"
          class="flex items-center gap-1 text-xs font-medium text-slate-500 hover:text-slate-900 border border-slate-200 rounded-full px-2.5 py-1"
          aria-haspopup="true"
          aria-expanded="false"
          data-lang-toggle
        >
          {lang.toUpperCase()}
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div
          class="absolute right-0 top-full mt-1 hidden w-24 rounded-xl border border-slate-200 bg-white py-1 shadow-lg"
          data-lang-menu
        >
          <a href={esHref} class={`flex items-center gap-2 px-3 py-1.5 text-xs hover:bg-slate-50 ${lang === 'es' ? 'font-semibold text-slate-900' : 'text-slate-600'}`}>
            <span>🇪🇸</span> Español
          </a>
          <a href={enHref} class={`flex items-center gap-2 px-3 py-1.5 text-xs hover:bg-slate-50 ${lang === 'en' ? 'font-semibold text-slate-900' : 'text-slate-600'}`}>
            <span>🇺🇸</span> English
          </a>
        </div>
      </div>
      <a href="https://app.cheflink.io/" class="text-sm font-medium text-slate-700 hover:text-slate-900">{t.login}</a>
      <a
        href={contactHref}
        class="inline-flex items-center rounded-full bg-orange-500 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-orange-500/40 hover:bg-orange-400"
      >
        {t.demo}
      </a>
    </div>

    <button
      type="button"
      class="inline-flex items-center justify-center rounded-full border border-slate-200 p-2 text-slate-700 md:hidden"
      aria-label={t.openNav}
      data-mobile-toggle
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <div class="mx-auto hidden max-w-7xl px-4 pb-4 sm:px-6 md:hidden" data-mobile-menu>
    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="flex flex-col gap-3 text-sm text-slate-800">
        <a href={`${homePath}#features`} class="rounded-lg px-3 py-2 hover:bg-slate-50">{t.features}</a>
        <a href={`${homePath}#how-it-works`} class="rounded-lg px-3 py-2 hover:bg-slate-50">{t.howItWorks}</a>
        <a href={`${homePath}#pricing`} class="rounded-lg px-3 py-2 hover:bg-slate-50">{t.pricing}</a>
        <a href={`${homePath}#faq`} class="rounded-lg px-3 py-2 hover:bg-slate-50">{t.faq}</a>
        <div class="border-t border-slate-100 mt-1 pt-1">
          <a href={esHref} class={`flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-50 ${lang === 'es' ? 'font-semibold text-slate-900' : 'text-slate-500'}`}><span>🇪🇸</span> Español</a>
          <a href={enHref} class={`flex items-center gap-2 rounded-lg px-3 py-2 text-sm hover:bg-slate-50 ${lang === 'en' ? 'font-semibold text-slate-900' : 'text-slate-500'}`}><span>🇺🇸</span> English</a>
        </div>
      </div>
      <div class="mt-4 flex flex-col gap-2">
        <a
          href={contactHref}
          class="rounded-full bg-orange-500 px-4 py-2 text-center text-sm font-semibold text-white hover:bg-orange-400"
        >
          {t.demo}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const dropdown = document.querySelector('[data-lang-dropdown]');
  const toggle = dropdown?.querySelector('[data-lang-toggle]');
  const menu = dropdown?.querySelector('[data-lang-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (e) => {
    if (!dropdown?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
