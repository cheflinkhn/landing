---
import { APP_NAME } from '../config/site';
interface Props {
  lang: 'es' | 'en';
  currentPage?: 'index' | 'contact' | 'privacy' | 'terms';
}

const { lang, currentPage = 'index' } = Astro.props;

const t = {
  es: {
    tagline: 'Pedidos por QR · Cuentas por mesa',
    features: 'Características',
    howItWorks: 'Cómo funciona',
    screenshots: 'Míralo en acción',
    pricing: 'Precios',
    faq: 'Preguntas frecuentes',
    demo: 'Agendar Demo',
    login: 'Log In',
    openNav: 'Abrir navegación',
  },
  en: {
    tagline: 'QR Orders · Table Tabs',
    features: 'Features',
    howItWorks: 'How it works',
    screenshots: 'See it in action',
    pricing: 'Pricing',
    faq: 'FAQ',
    demo: 'Book a Demo',
    login: 'Log In',
    openNav: 'Open navigation',
  },
}[lang];

const pageSlug: Record<string, string> = {
  index: '',
  contact: 'contact/',
  privacy: 'privacy/',
  terms: 'terms/',
};

const contactHref = `/${lang}/contact/`;
const homePath = `/${lang}/`;
const esHref = `/es/${pageSlug[currentPage]}`;
const enHref = `/en/${pageSlug[currentPage]}`;
---

<header class="sticky top-0 z-50 border-b border-sand-200/70 bg-cream/85 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
    <div class="flex items-center gap-2.5">
      <a href={homePath} class="flex items-center gap-2.5">
        <img src="/assets/img/logo.png" alt={`${APP_NAME} Logo`} class="h-9 w-9 rounded-lg ring-1 ring-sand-200" />
        <span class="font-display text-lg font-semibold tracking-tight text-ink">{APP_NAME}</span>
      </a>
    </div>

    <div class="hidden items-center gap-7 text-sm font-medium text-sand-600 md:flex">
      <a href={`${homePath}#how-it-works`} class="transition-colors hover:text-ink">{t.howItWorks}</a>
      <a href={`${homePath}#features`} class="transition-colors hover:text-ink">{t.features}</a>
      <a href={`${homePath}#screenshots`} class="transition-colors hover:text-ink">{t.screenshots}</a>
      <a href={`${homePath}#pricing`} class="hidden transition-colors hover:text-ink">{t.pricing}</a>
      <a href={`${homePath}#faq`} class="transition-colors hover:text-ink">{t.faq}</a>
    </div>

    <div class="hidden items-center gap-3 md:flex">
      <!-- Language toggle -->
      <div class="relative" data-lang-dropdown>
        <button
          type="button"
          class="flex items-center gap-1 rounded-full border border-sand-200 px-2.5 py-1.5 text-xs font-semibold tracking-wide text-sand-600 transition-colors hover:border-sand-300 hover:text-ink"
          aria-haspopup="true"
          aria-expanded="false"
          data-lang-toggle
        >
          {lang.toUpperCase()}
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div
          class="absolute right-0 top-full mt-1.5 hidden w-28 overflow-hidden rounded-xl border border-sand-200 bg-white py-1 shadow-soft"
          data-lang-menu
        >
          <a href={esHref} class={`block px-3 py-1.5 text-sm transition-colors hover:bg-sand-50 ${lang === 'es' ? 'font-semibold text-ink' : 'text-sand-600'}`}>Español</a>
          <a href={enHref} class={`block px-3 py-1.5 text-sm transition-colors hover:bg-sand-50 ${lang === 'en' ? 'font-semibold text-ink' : 'text-sand-600'}`}>English</a>
        </div>
      </div>
      <a href="https://app.cheflink.io/" class="text-sm font-medium text-sand-700 transition-colors hover:text-ink">{t.login}</a>
      <a
        href={contactHref}
        class="inline-flex items-center rounded-full bg-brand-700 px-4 py-2 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-brand-800"
      >
        {t.demo}
      </a>
    </div>

    <button
      type="button"
      class="inline-flex items-center justify-center rounded-full border border-sand-200 p-2 text-sand-700 transition-colors hover:border-sand-300 md:hidden"
      aria-label={t.openNav}
      data-mobile-toggle
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <div class="mx-auto hidden max-w-7xl px-4 pb-4 sm:px-6 md:hidden" data-mobile-menu>
    <div class="rounded-2xl border border-sand-200 bg-white p-4 shadow-soft">
      <div class="flex flex-col gap-1 text-sm font-medium text-sand-800">
        <a href={`${homePath}#how-it-works`} class="rounded-lg px-3 py-2 transition-colors hover:bg-sand-50">{t.howItWorks}</a>
        <a href={`${homePath}#features`} class="rounded-lg px-3 py-2 transition-colors hover:bg-sand-50">{t.features}</a>
        <a href={`${homePath}#screenshots`} class="rounded-lg px-3 py-2 transition-colors hover:bg-sand-50">{t.screenshots}</a>
        <a href={`${homePath}#pricing`} class="hidden rounded-lg px-3 py-2 transition-colors hover:bg-sand-50">{t.pricing}</a>
        <a href={`${homePath}#faq`} class="rounded-lg px-3 py-2 transition-colors hover:bg-sand-50">{t.faq}</a>
        <div class="mt-1 border-t border-sand-100 pt-2">
          <a href={esHref} class={`block rounded-lg px-3 py-2 transition-colors hover:bg-sand-50 ${lang === 'es' ? 'font-semibold text-ink' : 'text-sand-500'}`}>Español</a>
          <a href={enHref} class={`block rounded-lg px-3 py-2 transition-colors hover:bg-sand-50 ${lang === 'en' ? 'font-semibold text-ink' : 'text-sand-500'}`}>English</a>
        </div>
      </div>
      <div class="mt-3 flex flex-col gap-2">
        <a href="https://app.cheflink.io/" class="rounded-full border border-sand-200 px-4 py-2 text-center text-sm font-semibold text-sand-800 transition-colors hover:bg-sand-50">{t.login}</a>
        <a
          href={contactHref}
          class="rounded-full bg-brand-700 px-4 py-2 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-800"
        >
          {t.demo}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const dropdown = document.querySelector('[data-lang-dropdown]');
  const toggle = dropdown?.querySelector('[data-lang-toggle]');
  const menu = dropdown?.querySelector('[data-lang-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (e) => {
    if (!dropdown?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
