---
import { APP_NAME } from '../config/site';
interface Props {
  lang: 'es' | 'en';
  currentPage?: 'index' | 'contact' | 'privacy' | 'terms';
}

const { lang, currentPage = 'index' } = Astro.props;

const t = {
  es: {
    features: 'Características',
    howItWorks: 'Cómo funciona',
    screenshots: 'Míralo en acción',
    pricing: 'Precios',
    faq: 'Preguntas frecuentes',
    demo: 'Agendar demo',
    login: 'Log in',
    openNav: 'Abrir navegación',
  },
  en: {
    features: 'Features',
    howItWorks: 'How it works',
    screenshots: 'See it in action',
    pricing: 'Pricing',
    faq: 'FAQ',
    demo: 'Book a demo',
    login: 'Log in',
    openNav: 'Open navigation',
  },
}[lang];

const pageSlug: Record<string, string> = {
  index: '',
  contact: 'contact/',
  privacy: 'privacy/',
  terms: 'terms/',
};

const contactHref = `/${lang}/contact/`;
const homePath = `/${lang}/`;
const esHref = `/es/${pageSlug[currentPage]}`;
const enHref = `/en/${pageSlug[currentPage]}`;

const link = 'text-current opacity-75 transition-opacity hover:opacity-100';
---

<!-- The header takes the ground of the section under it (landing.js sets data-tone). -->
<header
  class="group sticky top-0 z-50 bg-cream text-ink transition-colors duration-500 data-[tone=dawn]:bg-dawn data-[tone=sand]:bg-sand-100 data-[tone=peach]:bg-brand-50 data-[tone=apricot]:bg-brand-100"
  data-nav
  data-tone="cream"
>
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
    <a href={homePath} class="flex items-center gap-2.5 text-current">
      <img src="/assets/img/logo.png" alt="" class="h-8 w-8 rounded-lg" width="32" height="32" />
      <span class="font-display text-[21px] font-semibold tracking-tight">{APP_NAME}</span>
    </a>

    <div class="hidden items-center gap-9 text-sm font-medium md:flex">
      <a href={`${homePath}#how-it-works`} class={link}>{t.howItWorks}</a>
      <a href={`${homePath}#features`} class={link}>{t.features}</a>
      <a href={`${homePath}#screenshots`} class={link}>{t.screenshots}</a>
      <a href={`${homePath}#pricing`} class={`hidden ${link}`}>{t.pricing}</a>
      <a href={`${homePath}#faq`} class={link}>{t.faq}</a>
    </div>

    <div class="hidden items-center gap-6 text-sm font-medium md:flex">
      <!-- Language toggle -->
      <div class="relative" data-lang-dropdown>
        <button
          type="button"
          class={`flex items-center gap-1 text-xs font-semibold tracking-wide ${link}`}
          aria-haspopup="true"
          aria-expanded="false"
          data-lang-toggle
        >
          {lang.toUpperCase()}
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div
          class="absolute right-0 top-full mt-2 hidden w-28 overflow-hidden rounded-lg border border-sand-300 bg-paper py-1 text-ink shadow-soft"
          data-lang-menu
        >
          <a href={esHref} class={`block px-3 py-1.5 text-sm transition-colors hover:bg-sand-100 ${lang === 'es' ? 'font-semibold' : 'text-sand-600'}`}>Español</a>
          <a href={enHref} class={`block px-3 py-1.5 text-sm transition-colors hover:bg-sand-100 ${lang === 'en' ? 'font-semibold' : 'text-sand-600'}`}>English</a>
        </div>
      </div>
      <a href="https://app.cheflink.io/" class={link}>{t.login}</a>
      <a
        href={contactHref}
        class="inline-flex h-11 items-center rounded-full bg-brand-700 px-5 font-semibold text-white transition-colors hover:bg-brand-800"
      >
        {t.demo}
      </a>
    </div>

    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-sand-300 text-current md:hidden"
      aria-label={t.openNav}
      data-mobile-toggle
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <div class="mx-auto hidden max-w-7xl px-4 pb-4 sm:px-6 md:hidden" data-mobile-menu>
    <div class="border border-ink bg-paper p-4 text-ink shadow-soft">
      <div class="flex flex-col text-sm font-medium">
        <a href={`${homePath}#how-it-works`} class="border-b border-sand-200 px-1 py-3">{t.howItWorks}</a>
        <a href={`${homePath}#features`} class="border-b border-sand-200 px-1 py-3">{t.features}</a>
        <a href={`${homePath}#screenshots`} class="border-b border-sand-200 px-1 py-3">{t.screenshots}</a>
        <a href={`${homePath}#pricing`} class="hidden border-b border-sand-200 px-1 py-3">{t.pricing}</a>
        <a href={`${homePath}#faq`} class="border-b border-sand-200 px-1 py-3">{t.faq}</a>
        <div class="flex gap-5 px-1 pt-3 text-sand-600">
          <a href={esHref} class={lang === 'es' ? 'font-semibold text-ink' : ''}>Español</a>
          <a href={enHref} class={lang === 'en' ? 'font-semibold text-ink' : ''}>English</a>
        </div>
      </div>
      <div class="mt-4 flex flex-col gap-2">
        <a href="https://app.cheflink.io/" class="flex h-11 items-center justify-center rounded-full border border-sand-300 text-sm font-semibold">{t.login}</a>
        <a href={contactHref} class="flex h-11 items-center justify-center rounded-full bg-brand-700 text-sm font-semibold text-white transition-colors hover:bg-brand-800">{t.demo}</a>
      </div>
    </div>
  </div>
</header>

<script>
  const dropdown = document.querySelector('[data-lang-dropdown]');
  const toggle = dropdown?.querySelector('[data-lang-toggle]');
  const menu = dropdown?.querySelector('[data-lang-menu]');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (e) => {
    if (!dropdown?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
