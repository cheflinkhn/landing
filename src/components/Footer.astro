---
// Footer set like the bottom of a guest check: dashed rules, receipt type, and a
// thank-you line. Sits on the ink ground so the closing CTA flows into it.
import { APP_NAME, INSTAGRAM_URL, FACEBOOK_URL } from '../config/site';
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const t = {
  es: {
    blurb: 'Salón, cocina y oficina de tu restaurante en un solo panel en tiempo real.',
    productTitle: 'Producto',
    features: 'Características',
    howItWorks: 'Cómo funciona',
    screenshots: 'Míralo en acción',
    pricing: 'Precios',
    faq: 'Preguntas frecuentes',
    companyTitle: 'Empresa',
    contact: 'Contacto',
    legalTitle: 'Legal',
    privacy: 'Privacidad',
    terms: 'Términos',
    rights: 'Todos los derechos reservados.',
    thanks: 'Gracias por su visita.',
  },
  en: {
    blurb: 'Your floor, kitchen and back office in one real-time dashboard.',
    productTitle: 'Product',
    features: 'Features',
    howItWorks: 'How it works',
    screenshots: 'See it in action',
    pricing: 'Pricing',
    faq: 'FAQ',
    companyTitle: 'Company',
    contact: 'Contact',
    legalTitle: 'Legal',
    privacy: 'Privacy',
    terms: 'Terms',
    rights: 'All rights reserved.',
    thanks: 'Thank you for your visit.',
  },
}[lang];

const home = `/${lang}/`;
const heading = 'mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-sand-600';
const item = 'block py-1.5 font-mono text-[13px] text-ink transition-opacity hover:opacity-70';
---

<footer class="bg-sand-200 text-ink">
  <div class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
    <div class="grid gap-8 border-t border-dashed border-sand-400 pt-9 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div class="max-w-xs">
        <a href={home} class="flex items-center gap-2.5 text-ink">
          <img src="/assets/img/logo.png" alt="" class="h-8 w-8 rounded-lg" width="32" height="32" />
          <span class="font-display text-[20px] font-semibold tracking-tight">{APP_NAME}</span>
        </a>
        <p class="mt-4 text-sm leading-6 text-sand-600">{t.blurb}</p>
      </div>

      <div>
        <h3 class={heading}>{t.productTitle}</h3>
        <a href={`${home}#features`} class={item}>{t.features}</a>
        <a href={`${home}#how-it-works`} class={item}>{t.howItWorks}</a>
        <a href={`${home}#screenshots`} class={item}>{t.screenshots}</a>
        <a href={`${home}#pricing`} class={`hidden ${item}`}>{t.pricing}</a>
        <a href={`${home}#faq`} class={item}>{t.faq}</a>
      </div>

      <div>
        <h3 class={heading}>{t.companyTitle}</h3>
        <a href={`/${lang}/contact/`} class={item}>{t.contact}</a>
        <div class="mt-2 flex items-center gap-3">
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full border border-sand-400 text-ink transition-colors hover:border-ink">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none" /></svg>
          </a>
          <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full border border-sand-400 text-ink transition-colors hover:border-ink">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.2h2.4l.4-2.9h-2.8V9.1c0-.8.3-1.4 1.5-1.4h1.4V5.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.6 1.3-3.6 3.7v2.2H8.2v2.9h2.4V21h2.9z" /></svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class={heading}>{t.legalTitle}</h3>
        <a href={`/${lang}/privacy/`} class={item}>{t.privacy}</a>
        <a href={`/${lang}/terms/`} class={item}>{t.terms}</a>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-baseline justify-between gap-3 border-t border-dashed border-sand-400 pt-5">
      <span class="font-mono text-xs text-sand-600">© <span data-year></span> {APP_NAME}. {t.rights}</span>
      <span class="font-display text-[19px] italic text-sand-700">{t.thanks}</span>
    </div>
  </div>
</footer>
