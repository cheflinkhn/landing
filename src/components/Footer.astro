---
import { APP_NAME, INSTAGRAM_URL, FACEBOOK_URL } from '../config/site';
interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const t = {
  es: {
    blurb: 'Pedidos por QR, cocina y cuentas por mesa en un solo panel en tiempo real.',
    productTitle: 'Producto',
    features: 'Características',
    howItWorks: 'Cómo funciona',
    pricing: 'Precios',
    faq: 'Preguntas frecuentes',
    companyTitle: 'Empresa',
    contact: 'Contacto',
    legalTitle: 'Legal',
    privacy: 'Privacidad',
    terms: 'Términos',
    cta: 'Agendar demo',
    rights: 'Todos los derechos reservados.',
  },
  en: {
    blurb: 'QR orders, kitchen, and table tabs in a single real-time dashboard.',
    productTitle: 'Product',
    features: 'Features',
    howItWorks: 'How it works',
    pricing: 'Pricing',
    faq: 'FAQ',
    companyTitle: 'Company',
    contact: 'Contact',
    legalTitle: 'Legal',
    privacy: 'Privacy',
    terms: 'Terms',
    cta: 'Book a demo',
    rights: 'All rights reserved.',
  },
}[lang];

const home = `/${lang}/`;
---

<footer class="border-t border-sand-200 bg-sand-50">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-xs">
        <div class="flex items-center gap-2.5">
          <img src="/assets/img/logo.png" alt={`${APP_NAME} Logo`} class="h-8 w-8 rounded-lg ring-1 ring-sand-200" />
          <span class="font-display text-lg font-semibold tracking-tight text-ink">{APP_NAME}</span>
        </div>
        <p class="mt-4 text-sm leading-6 text-sand-600">{t.blurb}</p>
        <a
          href={`/${lang}/contact/`}
          class="mt-5 inline-flex items-center rounded-full bg-brand-700 px-4 py-2 text-sm font-semibold text-white shadow-soft transition-colors hover:bg-brand-800"
        >
          {t.cta}
        </a>
        <div class="mt-5 flex items-center gap-3">
          <a
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-sand-500 transition-colors hover:text-ink"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href={FACEBOOK_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="text-sand-500 transition-colors hover:text-ink"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-sand-500">{t.productTitle}</h3>
        <ul class="mt-4 space-y-3 text-sm text-sand-600">
          <li><a href={`${home}#features`} class="transition-colors hover:text-ink">{t.features}</a></li>
          <li><a href={`${home}#how-it-works`} class="transition-colors hover:text-ink">{t.howItWorks}</a></li>
          <li class="hidden"><a href={`${home}#pricing`} class="transition-colors hover:text-ink">{t.pricing}</a></li>
          <li><a href={`${home}#faq`} class="transition-colors hover:text-ink">{t.faq}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-sand-500">{t.companyTitle}</h3>
        <ul class="mt-4 space-y-3 text-sm text-sand-600">
          <li><a href={`/${lang}/contact/`} class="transition-colors hover:text-ink">{t.contact}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-sand-500">{t.legalTitle}</h3>
        <ul class="mt-4 space-y-3 text-sm text-sand-600">
          <li><a href={`/${lang}/privacy/`} class="transition-colors hover:text-ink">{t.privacy}</a></li>
          <li><a href={`/${lang}/terms/`} class="transition-colors hover:text-ink">{t.terms}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-sand-200 pt-6 text-xs text-sand-500">
      © <span data-year></span> {APP_NAME}. {t.rights}
    </div>
  </div>
</footer>
